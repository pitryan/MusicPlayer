<?xml version="1.0" encoding="utf-8"?>
<!--
    Halaman artis seperti Apple Music: foto (cover rilis terbaru, karena tidak ada foto artis tanpa internet), nama,
    Latest Release dan Top Songs berdampingan, lalu Albums, Singles & EPs, dan Appears On. Bagian yang kosong
    disembunyikan dari kode.
-->
<Page
    x:Class="MusicPlayer.Pages.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.ViewModels">

    <Page.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,32,0,12" />
        </Style>

        <!-- Satu rilis di rak Albums, Singles & EPs, atau Appears On -->
        <DataTemplate x:Key="ReleaseTileTemplate" x:DataType="vm:AlbumItem">
            <StackPanel Width="160" Margin="0,0,0,8">
                <Grid PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited"
                    Width="160"
                    Height="160"
                    CornerRadius="6"
                    Background="{StaticResource CoverPlaceholderBrush}">
                    <FontIcon Glyph="&#xE93C;" FontSize="36" Foreground="{StaticResource SecondaryTextBrush}" />
                    <Border CornerRadius="6">
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
                <TextBlock
                    Text="{x:Bind Title}"
                    FontSize="13"
                    Margin="0,8,0,0"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
                <TextBlock
                    Text="{x:Bind Subtitle}"
                    FontSize="12"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,28,32,40">
            <!-- Kepala: foto bulat, nama, jumlah rilis dan lagu, Play dan Shuffle -->
            <Grid ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="180"
                    Height="180"
                    CornerRadius="90"
                    Background="{StaticResource CoverPlaceholderBrush}">
                    <FontIcon Glyph="&#xE77B;" FontSize="56" Foreground="{StaticResource SecondaryTextBrush}" />
                    <Border CornerRadius="90">
                        <Border.Background>
                            <ImageBrush x:Name="PhotoBrush" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="NameText" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="MetaText" Foreground="{StaticResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                        <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Padding="20,6" Click="Play_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Play" />
                                <TextBlock Text="Play" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ShuffleButton" Style="{StaticResource AccentButtonStyle}" Padding="20,6" Click="Shuffle_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Shuffle" />
                                <TextBlock Text="Shuffle" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Latest Release dan Top Songs berdampingan, seperti Apple Music -->
            <Grid x:Name="HighlightsRow" ColumnSpacing="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="LatestPanel">
                    <TextBlock Text="Latest Release" Style="{StaticResource SectionTitleStyle}" />
                    <Button
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Click="Latest_Click">
                        <StackPanel Width="200">
                            <Grid
                                Width="200"
                                Height="200"
                                CornerRadius="6"
                                Background="{StaticResource CoverPlaceholderBrush}">
                                <FontIcon Glyph="&#xE93C;" FontSize="40" Foreground="{StaticResource SecondaryTextBrush}" />
                                <Border CornerRadius="6">
                                    <Border.Background>
                                        <ImageBrush x:Name="LatestCoverBrush" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <!-- Contoh: "1 August 2024", "Samsa/kitty", "Single · 2 songs" -->
                            <TextBlock
                                x:Name="LatestDateText"
                                Margin="0,10,0,0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock
                                x:Name="LatestTitleText"
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                x:Name="LatestInfoText"
                                FontSize="12"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="TopSongsPanel" Grid.Column="1">
                    <TextBlock Text="Top Songs" Style="{StaticResource SectionTitleStyle}" />
                    <ListView
                        x:Name="TopSongsList"
                        SelectionMode="Single"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        DoubleTapped="TopSongsList_DoubleTapped"
                        RightTapped="TopSongsList_RightTapped"
                        ContainerContentChanging="TopSongsList_ContainerContentChanging">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="52" />
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrackRow">
                                <Grid ColumnSpacing="12" Padding="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Cover kecil; lagu yang sedang diputar ditandai ikon play di atasnya -->
                                    <Grid
                                        Width="40"
                                        Height="40"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource CoverPlaceholderBrush}">
                                        <Border CornerRadius="4">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <Grid CornerRadius="4" Background="#99000000" Visibility="{x:Bind PlayingVisibility, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="White" />
                                        </Grid>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock
                                            Text="{x:Bind AlbumText}"
                                            FontSize="12"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1" />
                                    </StackPanel>
                                    <FontIcon
                                        Grid.Column="2"
                                        Glyph="&#xE735;"
                                        FontSize="10"
                                        Foreground="{StaticResource AccentRedBrush}"
                                        Visibility="{x:Bind FavouriteVisibility, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="3"
                                        Padding="6,2"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Right"
                                        ToolTipService.ToolTip="More"
                                        Click="TopSongMore_Click">
                                        <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{StaticResource AccentRedBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>

            <!-- Rak rilis. Scroll vertikal dimatikan, supaya roda mouse menggulir seluruh halaman, bukan raknya -->
            <TextBlock x:Name="AlbumsTitle" Text="Albums" Style="{StaticResource SectionTitleStyle}" />
            <GridView
                x:Name="AlbumsGrid"
                ItemTemplate="{StaticResource ReleaseTileTemplate}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ItemClick="Release_ItemClick"
                ContainerContentChanging="Release_ContainerContentChanging" />

            <TextBlock x:Name="SinglesTitle" Text="Singles &amp; EPs" Style="{StaticResource SectionTitleStyle}" />
            <GridView
                x:Name="SinglesGrid"
                ItemTemplate="{StaticResource ReleaseTileTemplate}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ItemClick="Release_ItemClick"
                ContainerContentChanging="Release_ContainerContentChanging" />

            <TextBlock x:Name="AppearsOnTitle" Text="Appears On" Style="{StaticResource SectionTitleStyle}" />
            <GridView
                x:Name="AppearsOnGrid"
                ItemTemplate="{StaticResource ReleaseTileTemplate}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ItemClick="Release_ItemClick"
                ContainerContentChanging="Release_ContainerContentChanging" />
        </StackPanel>
    </ScrollViewer>
</Page>
