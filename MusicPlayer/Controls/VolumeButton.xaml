<?xml version="1.0" encoding="utf-8"?>
<!--
    Tombol volume dan popup-nya (mute, slider, keterangan cara volume diatur). Scroll di atas tombol mengubah
    volume. Dipakai di jendela utama dan di MiniPlayer.
-->
<UserControl
    x:Class="MusicPlayer.Controls.VolumeButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MusicPlayer.Helpers">

    <Button
        x:Name="VolumeIconButton"
        Padding="8"
        MinWidth="40"
        MinHeight="40"
        Background="Transparent"
        BorderThickness="0"
        ToolTipService.ToolTip="Volume (scroll to adjust)"
        PointerWheelChanged="VolumeButton_PointerWheelChanged">
        <FontIcon Glyph="{x:Bind Playback.VolumeGlyph, Mode=OneWay}" FontSize="16" />
        <Button.Flyout>
            <Flyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                <StackPanel Width="300" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton
                            x:Name="MuteToggle"
                            Padding="6"
                            Background="Transparent"
                            BorderThickness="0"
                            IsChecked="{x:Bind Playback.IsMuted, Mode=OneWay}"
                            Click="MuteToggle_Click"
                            ToolTipService.ToolTip="Mute">
                            <FontIcon Glyph="&#xE74F;" FontSize="14" />
                        </ToggleButton>
                        <Slider
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="100"
                            StepFrequency="1"
                            Value="{x:Bind Playback.Volume, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind helpers:Formatters.Percent(Playback.Volume), Mode=OneWay}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock
                        Text="{x:Bind Playback.VolumeDescription, Mode=OneWay}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
