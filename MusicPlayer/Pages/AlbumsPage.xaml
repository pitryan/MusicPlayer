<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MusicPlayer.Pages.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicPlayer.Controls"
    xmlns:vm="using:MusicPlayer.ViewModels"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kepala halaman gaya Apple Music: judul kecil di tengah, jumlah album di kanan -->
        <controls:PageHeader x:Name="Header" Margin="-24,-20,0,12" />

        <!-- Dipakai untuk Albums dan album per genre (tanpa kelompok), serta Recently Added dan Recently Played (berkelompok) -->
        <!-- Kotak sebesar Apple Music: lebar kotak mengikuti lebar jendela (lihat TileGrid) -->
        <GridView
            x:Name="AlbumGrid"
            Grid.Row="1"
            Padding="16,0,16,24"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="AlbumGrid_ItemClick"
            SizeChanged="AlbumGrid_SizeChanged"
            Loaded="AlbumGrid_Loaded"
            ContainerContentChanging="AlbumGrid_ContainerContentChanging">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:AlbumGroup">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:AlbumItem">
                    <!-- Jarak antar kotak (20 px) dibawa oleh setiap kotak di kanan dan bawahnya -->
                    <StackPanel Margin="0,0,20,20">
                        <!-- Placeholder abu-abu dengan ikon, tertutup cover saat sudah dimuat; membesar sedikit saat kursor di atasnya -->
                        <controls:SquareBox>
                            <Grid PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited"
                                CornerRadius="6"
                                Background="{StaticResource CoverPlaceholderBrush}">
                                <FontIcon Glyph="&#xE93C;" FontSize="40" Foreground="{StaticResource SecondaryTextBrush}" />
                                <Border CornerRadius="6">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </controls:SquareBox>
                        <TextBlock
                            Text="{x:Bind Title}"
                            FontSize="13"
                            Margin="0,8,0,0"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                        <TextBlock
                            Text="{x:Bind Artist}"
                            FontSize="12"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            Visibility="Collapsed"
            Spacing="8"
            Margin="0,48,24,0"
            HorizontalAlignment="Center">
            <TextBlock
                x:Name="EmptyTitle"
                Text="No albums yet"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="EmptyDetail"
                Text="Add a music folder in Settings (the gear icon at the bottom left)."
                HorizontalAlignment="Center"
                Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</Page>
