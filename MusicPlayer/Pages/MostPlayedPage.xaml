<?xml version="1.0" encoding="utf-8"?>
<!--
    Most Played: lagu yang paling sering diputar, dihitung dari History (lagu masuk History setelah didengar separuh
    durasinya atau 4 menit). Baris bergaya halaman playlist, dengan peringkat dan jumlah putar.
-->
<Page
    x:Class="MusicPlayer.Pages.MostPlayedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicPlayer.Controls"
    xmlns:vm="using:MusicPlayer.ViewModels">

    <Page.Resources>
        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="-24,-20,-24,12">
            <controls:PageHeader x:Name="Header" Title="Most Played" />
            <!-- Rentang waktu yang dihitung -->
            <SelectorBar
                x:Name="RangeTabs"
                HorizontalAlignment="Right"
                Margin="0,8,24,0"
                SelectionChanged="RangeTabs_SelectionChanged">
                <SelectorBarItem x:Name="AllTimeTab" Text="All Time" IsSelected="True" />
                <SelectorBarItem x:Name="LastMonthTab" Text="Last 30 Days" />
            </SelectorBar>
        </StackPanel>

        <!-- Judul kolom. Lebar kolomnya harus sama dengan template baris di bawah -->
        <Grid x:Name="ColumnHeaders" Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="3" Text="Song" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="4" Text="Artist" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="5" Text="Album" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="6" Text="Plays" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="7" Text="Time" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right" />
        </Grid>

        <ListView
            x:Name="TrackList"
            Grid.Row="2"
            SelectionMode="Single"
            DoubleTapped="TrackList_DoubleTapped"
            RightTapped="TrackList_RightTapped"
            ContainerContentChanging="TrackList_ContainerContentChanging">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="52" />
                    <Setter Property="CornerRadius" Value="4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackRow">
                    <Grid ColumnSpacing="12" Padding="12,0" CornerRadius="4" Background="{x:Bind RowBackground}">
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>

                        <!-- Bintang merah untuk lagu favorit -->
                        <FontIcon
                            Glyph="&#xE735;"
                            FontSize="10"
                            Foreground="{StaticResource AccentRedBrush}"
                            Visibility="{x:Bind FavouriteVisibility, Mode=OneWay}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind RankText}"
                            Style="{StaticResource CellStyle}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Right" />

                        <!-- Cover kecil; lagu yang sedang diputar ditandai ikon play di atasnya -->
                        <Grid
                            Grid.Column="2"
                            Width="40"
                            Height="40"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Background="{StaticResource CoverPlaceholderBrush}">
                            <Border CornerRadius="4">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Grid CornerRadius="4" Background="#99000000" Visibility="{x:Bind PlayingVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="White" />
                            </Grid>
                        </Grid>

                        <TextBlock Grid.Column="3" Text="{x:Bind Title}" Style="{StaticResource CellStyle}" />
                        <TextBlock
                            Grid.Column="4"
                            Text="{x:Bind ArtistText}"
                            Style="{StaticResource CellStyle}"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock
                            Grid.Column="5"
                            Text="{x:Bind AlbumText}"
                            Style="{StaticResource CellStyle}"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock
                            Grid.Column="6"
                            Text="{x:Bind PlaysText}"
                            Style="{StaticResource CellStyle}"
                            HorizontalAlignment="Right" />
                        <TextBlock
                            Grid.Column="7"
                            Text="{x:Bind DurationText}"
                            Style="{StaticResource CellStyle}"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Right" />
                        <!-- Menu yang sama dengan klik kanan -->
                        <Button
                            Grid.Column="8"
                            Padding="6,2"
                            MinWidth="0"
                            MinHeight="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            ToolTipService.ToolTip="More"
                            Click="RowMore_Click">
                            <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{StaticResource AccentRedBrush}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            Visibility="Collapsed"
            Spacing="8"
            Margin="0,48,0,0"
            HorizontalAlignment="Center">
            <TextBlock
                x:Name="EmptyTitle"
                Text="Nothing played yet"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="A song counts as played after you've listened to half of it, or 4 minutes."
                HorizontalAlignment="Center"
                Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</Page>
