<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MusicPlayer.Pages.AlbumDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.ViewModels">

    <Page.Resources>
        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
    </Page.Resources>

    <!-- Kepala halaman ikut ter-scroll bersama daftar lagu, seperti di Apple Music -->
    <ListView
        x:Name="TrackList"
        Padding="32,0,32,0"
        SelectionMode="Single"
        DoubleTapped="TrackList_DoubleTapped"
        RightTapped="TrackList_RightTapped">

        <ListView.Header>
            <Grid ColumnSpacing="32" Margin="0,32,0,24" Height="260">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid CornerRadius="8" Background="{StaticResource CoverPlaceholderBrush}">
                    <FontIcon Glyph="&#xE93C;" FontSize="64" Foreground="{StaticResource SecondaryTextBrush}" />
                    <Border CornerRadius="8">
                        <Border.Background>
                            <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="AlbumTitleText"
                        Grid.Row="1"
                        FontSize="28"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis" />
                    <!-- Nama artis bisa diklik: membuka artis itu di halaman Artists, sama seperti "Go to Artist" -->
                    <HyperlinkButton
                        x:Name="ArtistLink"
                        Grid.Row="2"
                        Padding="0"
                        ToolTipService.ToolTip="Go to artist"
                        Click="ArtistLink_Click">
                        <TextBlock
                            x:Name="ArtistText"
                            FontSize="28"
                            Foreground="{StaticResource AccentRedBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </HyperlinkButton>

                    <!-- Contoh: "Alternative Rock · 2026 ·" lalu ikon dan teks kualitas tanpa kotak, seperti Apple Music.
                         Ikon golongan kualitas: desain asli MusicPlayer, sama dengan di badge LCD. -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                        <TextBlock
                            x:Name="MetaText"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            VerticalAlignment="Center" />
                        <StackPanel x:Name="QualityBadge" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                <Grid Width="20" Height="20">
                                    <PathIcon
                                        x:Name="HiResIcon"
                                        Data="F1 M1,8.4 A0.9,0.9 0 0 1 2.8,8.4 V11.6 A0.9,0.9 0 0 1 1,11.6 Z M3.7,6.4 A0.9,0.9 0 0 1 5.5,6.4 V13.6 A0.9,0.9 0 0 1 3.7,13.6 Z M6.4,4.4 A0.9,0.9 0 0 1 8.2,4.4 V15.6 A0.9,0.9 0 0 1 6.4,15.6 Z M9.1,2.4 A0.9,0.9 0 0 1 10.9,2.4 V17.6 A0.9,0.9 0 0 1 9.1,17.6 Z M11.8,4.4 A0.9,0.9 0 0 1 13.6,4.4 V15.6 A0.9,0.9 0 0 1 11.8,15.6 Z M14.5,6.4 A0.9,0.9 0 0 1 16.3,6.4 V13.6 A0.9,0.9 0 0 1 14.5,13.6 Z M17.2,8.4 A0.9,0.9 0 0 1 19,8.4 V11.6 A0.9,0.9 0 0 1 17.2,11.6 Z"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <PathIcon
                                        x:Name="LosslessIcon"
                                        Data="F1 M0.9,8.3 A1.3,1.3 0 0 1 3.5,8.3 V11.7 A1.3,1.3 0 0 1 0.9,11.7 Z M4.8,5.8 A1.3,1.3 0 0 1 7.4,5.8 V14.2 A1.3,1.3 0 0 1 4.8,14.2 Z M8.7,3.3 A1.3,1.3 0 0 1 11.3,3.3 V16.7 A1.3,1.3 0 0 1 8.7,16.7 Z M12.6,5.8 A1.3,1.3 0 0 1 15.2,5.8 V14.2 A1.3,1.3 0 0 1 12.6,14.2 Z M16.5,8.3 A1.3,1.3 0 0 1 19.1,8.3 V11.7 A1.3,1.3 0 0 1 16.5,11.7 Z"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <PathIcon
                                        x:Name="LossyIcon"
                                        Data="F1 M0.9,8.2 A1.3,1.3 0 1 1 3.5,8.2 A1.3,1.3 0 1 1 0.9,8.2 Z M0.9,11.8 A1.3,1.3 0 1 1 3.5,11.8 A1.3,1.3 0 1 1 0.9,11.8 Z M4.8,6.4 A1.3,1.3 0 1 1 7.4,6.4 A1.3,1.3 0 1 1 4.8,6.4 Z M4.8,10 A1.3,1.3 0 1 1 7.4,10 A1.3,1.3 0 1 1 4.8,10 Z M4.8,13.6 A1.3,1.3 0 1 1 7.4,13.6 A1.3,1.3 0 1 1 4.8,13.6 Z M8.7,4.6 A1.3,1.3 0 1 1 11.3,4.6 A1.3,1.3 0 1 1 8.7,4.6 Z M8.7,8.2 A1.3,1.3 0 1 1 11.3,8.2 A1.3,1.3 0 1 1 8.7,8.2 Z M8.7,11.8 A1.3,1.3 0 1 1 11.3,11.8 A1.3,1.3 0 1 1 8.7,11.8 Z M8.7,15.4 A1.3,1.3 0 1 1 11.3,15.4 A1.3,1.3 0 1 1 8.7,15.4 Z M12.6,6.4 A1.3,1.3 0 1 1 15.2,6.4 A1.3,1.3 0 1 1 12.6,6.4 Z M12.6,10 A1.3,1.3 0 1 1 15.2,10 A1.3,1.3 0 1 1 12.6,10 Z M12.6,13.6 A1.3,1.3 0 1 1 15.2,13.6 A1.3,1.3 0 1 1 12.6,13.6 Z M16.5,8.2 A1.3,1.3 0 1 1 19.1,8.2 A1.3,1.3 0 1 1 16.5,8.2 Z M16.5,11.8 A1.3,1.3 0 1 1 19.1,11.8 A1.3,1.3 0 1 1 16.5,11.8 Z"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                </Grid>
                            </Viewbox>
                            <TextBlock
                                x:Name="QualityBadgeText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Menu satu album: Play Next, Add to Queue, Go to Artist, Show in File Explorer -->
                    <Button
                        x:Name="AlbumMoreButton"
                        Grid.Row="5"
                        Padding="8,4"
                        MinWidth="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="More"
                        Click="AlbumMore_Click">
                        <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{StaticResource AccentRedBrush}" />
                    </Button>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource AccentButtonStyle}" Padding="20,6" Click="Play_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Play" />
                                <TextBlock Text="Play" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentButtonStyle}" Padding="20,6" Click="Shuffle_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Shuffle" />
                                <TextBlock Text="Shuffle" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </ListView.Header>

        <ListView.ItemContainerStyle>
            <!-- Isi baris dibuat memenuhi seluruh kotaknya, supaya latar belangnya menutup satu baris penuh -->
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </ListView.ItemContainerStyle>

        <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:TrackRow">
                <Grid
                    ColumnSpacing="16"
                    Padding="12,0"
                    CornerRadius="4"
                    Background="{x:Bind RowBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <!-- Bintang merah untuk lagu favorit, di kiri nomor track seperti Apple Music -->
                    <FontIcon
                        Glyph="&#xE735;"
                        FontSize="10"
                        Foreground="{StaticResource AccentRedBrush}"
                        Visibility="{x:Bind FavouriteVisibility, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" />
                    <!-- Nomor track, atau ikon play merah kalau lagu ini sedang diputar -->
                    <TextBlock
                        Text="{x:Bind NumberText}"
                        Visibility="{x:Bind NumberVisibility, Mode=OneWay}"
                        Style="{StaticResource CellStyle}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Right" />
                    <FontIcon
                        Glyph="&#xE768;"
                        FontSize="12"
                        Foreground="{StaticResource AccentRedBrush}"
                        Visibility="{x:Bind PlayingVisibility, Mode=OneWay}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

                    <!-- Judul, dan di bawahnya artis lagu kalau berbeda dari artis album -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Padding="0,6">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind ArtistUnderTitle}"
                            Visibility="{x:Bind ArtistUnderTitleVisibility}"
                            FontSize="12"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind DurationText}"
                        Style="{StaticResource CellStyle}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Right" />
                    <!-- Menu yang sama dengan klik kanan, seperti tombol ••• di Apple Music -->
                    <Button
                        Grid.Column="3"
                        Padding="6,2"
                        MinWidth="0"
                        MinHeight="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        ToolTipService.ToolTip="More"
                        Click="RowMore_Click">
                        <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{StaticResource AccentRedBrush}" />
                    </Button>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>

        <!-- Kaki halaman seperti Apple Music: tanggal rilis, jumlah lagu, durasi, ukuran file, dan copyright -->
        <ListView.Footer>
            <StackPanel Margin="12,20,0,40" Spacing="2" VerticalAlignment="Top">
                <TextBlock x:Name="FooterYearText" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock x:Name="FooterCountText" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock
                    x:Name="FooterCopyrightText"
                    FontWeight="SemiBold"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}" />
                <!-- "More by": rilis lain dari artis yang sama, terbaru dulu; disembunyikan kalau tidak ada -->
                <StackPanel x:Name="MoreBySection" Margin="0,32,0,0" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="MoreByTitle" FontSize="20" FontWeight="SemiBold" />
                    <!--
                        Rak yang digulir mendatar tanpa scrollbar. Panah kiri muncul setelah digulir ke kanan, panah kanan
                        hilang di ujung kanan, seperti Apple Music.
                    -->
                    <Grid>
                        <ScrollViewer
                            x:Name="MoreByScroller"
                            HorizontalScrollMode="Enabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Disabled"
                            ViewChanged="MoreByScroller_ViewChanged"
                            SizeChanged="MoreByShelf_SizeChanged">
                            <ItemsRepeater x:Name="MoreByList" SizeChanged="MoreByShelf_SizeChanged">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="20" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlbumItem">
                                        <StackPanel Width="180" Spacing="2" Tapped="MoreByItem_Tapped">
                                            <Border
                                                Width="180"
                                                Height="180"
                                                CornerRadius="6"
                                                Background="{StaticResource CoverPlaceholderBrush}"
                                                PointerEntered="Tile_PointerEntered"
                                                PointerExited="Tile_PointerExited">
                                                <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Title}" Margin="0,6,0,0" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock Text="{x:Bind YearText}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                        <!-- Panah bulat di tengah tinggi cover -->
                        <Button
                            x:Name="MoreByLeft"
                            Style="{StaticResource ShelfArrowButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="-14,72,0,0"
                            ToolTipService.ToolTip="Previous"
                            Visibility="Collapsed"
                            Click="MoreByLeft_Click">
                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="MoreByRight"
                            Style="{StaticResource ShelfArrowButtonStyle}"
                            HorizontalAlignment="Right"
                            Margin="0,72,-14,0"
                            ToolTipService.ToolTip="Next"
                            Visibility="Collapsed"
                            Click="MoreByRight_Click">
                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ListView.Footer>
    </ListView>
</Page>
