<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MusicPlayer.Pages.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lib="using:MusicPlayer.Library"
    xmlns:helpers="using:MusicPlayer.Helpers">

    <Page.Resources>
        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <TextBlock Text="Songs" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="CountText"
                VerticalAlignment="Bottom"
                Margin="0,0,0,4"
                Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>

        <!-- Judul kolom. Lebar kolomnya harus sama dengan template baris di bawah -->
        <Grid Grid.Row="1" Padding="16,0,16,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Title" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="1" Text="Time" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="2" Text="Artist" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="3" Text="Album" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="4" Text="Genre" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock Grid.Column="5" Text="Quality" Style="{StaticResource ColumnHeaderStyle}" />
        </Grid>

        <ListView
            x:Name="SongsList"
            Grid.Row="2"
            SelectionMode="Single"
            DoubleTapped="SongsList_DoubleTapped">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="36" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="lib:Track">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource CellStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind helpers:Formatters.Time(Duration)}"
                            Style="{StaticResource CellStyle}"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind DisplayArtist}" Style="{StaticResource CellStyle}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind DisplayAlbum}" Style="{StaticResource CellStyle}" />
                        <TextBlock
                            Grid.Column="4"
                            Text="{x:Bind Genre}"
                            Style="{StaticResource CellStyle}"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock
                            Grid.Column="5"
                            Text="{x:Bind QualityLabel}"
                            Style="{StaticResource CellStyle}"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            Visibility="Collapsed"
            Spacing="8"
            Margin="0,48,0,0"
            HorizontalAlignment="Center">
            <TextBlock
                Text="Your library is empty"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Add a music folder in Settings (the gear icon at the bottom left)."
                Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</Page>
