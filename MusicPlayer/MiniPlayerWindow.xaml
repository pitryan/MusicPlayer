<?xml version="1.0" encoding="utf-8"?>
<!--
    MiniPlayer: jendela kecil yang selalu di atas jendela lain (seperti MiniPlayer Apple Music). Selama terbuka,
    jendela utama disembunyikan. Ikon tombol layar penuh: Fluent UI System Icons (Microsoft, lisensi MIT).
-->
<Window
    x:Class="MusicPlayer.MiniPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicPlayer.Controls"
    xmlns:vm="using:MusicPlayer.ViewModels"
    Title="MusicPlayer">

    <!-- Latar gelap semi-transparan di atas efek acrylic, supaya teks tetap terbaca di tema Windows apa pun -->
    <Grid Background="#B81C1C1C" Padding="12,10,12,8" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Baris atas sekaligus title bar: diseret untuk memindah jendela. Badge dan tombol layar penuh tetap bisa diklik. -->
        <Grid x:Name="InfoArea" ColumnSpacing="10" Background="Transparent" SizeChanged="TitleBarArea_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionColumn" Width="46" />
            </Grid.ColumnDefinitions>

            <Grid Width="56" Height="56" CornerRadius="4" Background="{StaticResource CoverPlaceholderBrush}">
                <FontIcon Glyph="&#xE8D6;" FontSize="20" Foreground="{StaticResource SecondaryTextBrush}" />
                <Border CornerRadius="4">
                    <Border.Background>
                        <ImageBrush ImageSource="{x:Bind Playback.CurrentCover, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <controls:MarqueeText
                    Text="{x:Bind Playback.TitleText, Mode=OneWay}"
                    FontSize="13"
                    FontWeight="SemiBold" />
                <controls:MarqueeText
                    Text="{x:Bind Playback.SubtitleText, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{StaticResource SecondaryTextBrush}" />
                <controls:QualityBadge
                    x:Name="Badge"
                    IsCompact="True"
                    HorizontalAlignment="Center"
                    Margin="0,2,0,0"
                    SizeChanged="TitleBarArea_SizeChanged" />
            </StackPanel>

            <Button
                x:Name="FullScreenButton"
                Grid.Column="2"
                Padding="6"
                Background="Transparent"
                BorderThickness="0"
                VerticalAlignment="Top"
                Margin="0,-12,-12,0"
                ToolTipService.ToolTip="Full screen"
                Click="FullScreenButton_Click">
                <PathIcon Data="F1 M15.5 4C15.7761 4 16 4.22386 16 4.5V10.5C16 10.7761 15.7761 11 15.5 11C15.2239 11 15 10.7761 15 10.5V5.70703L5.70703 15H10.5C10.7761 15 11 15.2239 11 15.5C11 15.7761 10.7761 16 10.5 16H4.5C4.22386 16 4 15.7761 4 15.5V9.5C4 9.22386 4.22386 9 4.5 9C4.77614 9 5 9.22386 5 9.5V14.293L14.293 5H9.5C9.22386 5 9 4.77614 9 4.5C9 4.22386 9.22386 4 9.5 4H15.5Z" />
            </Button>
        </Grid>

        <!-- Progres lagu: klik di garis untuk lompat ke posisi itu, sama seperti di LCD -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="{x:Bind Playback.ElapsedText, Mode=OneWay}"
                FontSize="11"
                Foreground="{StaticResource SecondaryTextBrush}"
                VerticalAlignment="Center" />
            <Grid
                Grid.Column="1"
                Height="14"
                Background="Transparent"
                PointerPressed="SeekBar_PointerPressed">
                <ProgressBar
                    Minimum="0"
                    Maximum="{x:Bind Playback.DurationSeconds, Mode=OneWay}"
                    Value="{x:Bind Playback.PositionSeconds, Mode=OneWay}"
                    Foreground="#CCFFFFFF"
                    VerticalAlignment="Center" />
            </Grid>
            <TextBlock
                Grid.Column="2"
                Text="{x:Bind Playback.RemainingText, Mode=OneWay}"
                FontSize="11"
                Foreground="{StaticResource SecondaryTextBrush}"
                VerticalAlignment="Center" />
        </Grid>

        <!--
            Volume di kiri, tombol transport di tengah, lirik dan antrean di kanan (seperti MiniPlayer Apple Music).
            Tombol lirik dan antrean memanjangkan jendela ke bawah dan menampilkan panelnya; satu panel sekaligus.
        -->
        <Grid Grid.Row="2">
            <controls:VolumeButton HorizontalAlignment="Left" VerticalAlignment="Center" />
            <controls:TransportButtons HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                <ToggleButton
                    x:Name="LyricsToggle"
                    Padding="6"
                    MinWidth="32"
                    MinHeight="32"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Lyrics"
                    Click="PanelToggle_Click">
                    <PathIcon Data="F1 M13 4C13 2.89543 12.1046 2 11 2C9.89543 2 9 2.89543 9 4C9 5.10457 9.89543 6 11 6C11.309 6 11.6015 5.92995 11.8628 5.80486C11.7521 6.47377 11.5779 7.05617 11.3527 7.58352C10.9446 8.53915 10.3576 9.34113 9.6255 10.1687C9.44254 10.3755 9.46188 10.6915 9.66871 10.8745C9.87554 11.0575 10.1915 11.0381 10.3745 10.8313C11.1424 9.96322 11.8054 9.06955 12.2723 7.97626C12.7404 6.88025 13 5.6107 13 4ZM18 8.78907V12.2764C18 13.6935 16.8359 14.8423 15.4 14.8423H10.81L6.79895 17.8034C6.35668 18.1298 5.73 18.0406 5.39921 17.6042C5.26989 17.4335 5.2 17.2262 5.2 17.0133L5.19937 14.8423H4.6C3.16406 14.8423 2 13.6935 2 12.2764V5.56582C2 4.14876 3.16406 3 4.6 3H8.17071C8.06015 3.31278 8 3.64936 8 4H4.6C3.70383 4 3 4.71348 3 5.56582V12.2764C3 13.1288 3.70383 13.8423 4.6 13.8423H6.19908L6.2 17L6.20346 16.9997L6.20502 16.9988L10.4809 13.8423H15.4C16.2962 13.8423 17 13.1288 17 12.2764V10.4204C17.3706 9.91978 17.7103 9.38326 18 8.78907ZM16 2C17.1046 2 18 2.89543 18 4C18 5.6107 17.7404 6.88025 17.2723 7.97626C16.8054 9.06955 16.1424 9.96322 15.3745 10.8313C15.1915 11.0381 14.8755 11.0575 14.6687 10.8745C14.4619 10.6915 14.4425 10.3755 14.6255 10.1687C15.3576 9.34113 15.9446 8.53915 16.3527 7.58352C16.5779 7.05617 16.7521 6.47377 16.8628 5.80486C16.6015 5.92995 16.309 6 16 6C14.8954 6 14 5.10457 14 4C14 2.89543 14.8954 2 16 2Z" />
                </ToggleButton>
                <ToggleButton
                    x:Name="QueueToggle"
                    Padding="6"
                    MinWidth="32"
                    MinHeight="32"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Playing Next"
                    Click="PanelToggle_Click">
                    <controls:QueueGlyph />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Panel yang muncul saat jendela memanjang: lirik atau antrean -->
        <Grid x:Name="PanelArea" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed">
            <controls:LyricsView
                x:Name="MiniLyrics"
                Visibility="Collapsed"
                LineFontSize="18"
                ActiveLinePosition="0.35"
                FadeByDistance="True" />

            <Grid x:Name="MiniQueue" Visibility="Collapsed" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Playing Next" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center" />
                    <controls:QueueModeButtons HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ListView
                    x:Name="MiniQueueList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind Playback.UpNext}"
                    SelectionMode="Single"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    DoubleTapped="MiniQueueList_DoubleTapped"
                    RightTapped="MiniQueueList_RightTapped"
                    ContainerContentChanging="MiniQueueList_ContainerContentChanging">
                    <!-- Lagu masuk, keluar, dan berpindah dengan animasi; saat panel dibuka, isinya muncul berurutan -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                            <AddDeleteThemeTransition />
                            <ReorderThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,3" />
                            <Setter Property="MinHeight" Value="44" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:QueueEntry">
                            <Grid ColumnSpacing="10" Opacity="{x:Bind ItemOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="36" Height="36" CornerRadius="4" Background="{StaticResource CoverPlaceholderBrush}">
                                    <Border CornerRadius="4">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock
                                        Text="{x:Bind Subtitle, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind DurationText, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="MiniQueueEmpty"
                    Grid.Row="1"
                    Text="Nothing is playing next."
                    Margin="4,8,0,0"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
