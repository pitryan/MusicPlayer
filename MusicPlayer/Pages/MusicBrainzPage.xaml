<?xml version="1.0" encoding="utf-8"?>
<!--
    Look up on MusicBrainz, seperti Lookup di Picard: cari rilis, pilih edisi yang tepat, lihat pencocokan file dengan
    lagu-lagunya, lalu simpan. Dibuka dari editor tag.
-->
<Page
    x:Class="MusicPlayer.Pages.MusicBrainzPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.ViewModels">

    <Grid Padding="32,24,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kepala: judul dan tombol Cancel/Save -->
        <Grid>
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="Look Up on MusicBrainz" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" />
                <Button
                    x:Name="SaveButton"
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    Click="Save_Click" />
            </StackPanel>
        </Grid>

        <!-- Pencarian: judul album dan artis, sudah terisi dari tag -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AlbumBox" Header="Album" PlaceholderText="Album title" KeyDown="SearchBox_KeyDown" />
            <TextBox x:Name="ArtistBox" Grid.Column="1" Header="Artist" PlaceholderText="Artist (optional)" KeyDown="SearchBox_KeyDown" />
            <Button
                x:Name="SearchButton"
                Grid.Column="2"
                Content="Search"
                VerticalAlignment="Bottom"
                Click="Search_Click" />
        </Grid>

        <TextBlock
            x:Name="MessageText"
            Grid.Row="2"
            TextWrapping="Wrap"
            Foreground="{StaticResource SecondaryTextBrush}"
            Visibility="Collapsed" />

        <Grid Grid.Row="3" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Hasil pencarian: pilih edisi yang sama dengan file-mu (jumlah lagu, format, negara) -->
            <ListView
                x:Name="ResultsList"
                SelectionMode="Single"
                SelectionChanged="ResultsList_SelectionChanged"
                ContainerContentChanging="ResultsList_ContainerContentChanging">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MbResultItem">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="48"
                                Height="48"
                                CornerRadius="4"
                                VerticalAlignment="Top"
                                Background="{StaticResource CoverPlaceholderBrush}">
                                <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock
                                    Text="{x:Bind ArtistText}"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />
                                <TextBlock
                                    Text="{x:Bind DetailsText}"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    TextWrapping="Wrap"
                                    MaxLines="2" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Pratinjau rilis yang dipilih: data rilis, pilihan, dan pasangan file dengan lagunya -->
            <ScrollViewer Grid.Column="1">
                <StackPanel x:Name="PreviewPanel" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="140"
                            Height="140"
                            CornerRadius="6"
                            Background="{StaticResource CoverPlaceholderBrush}">
                            <FontIcon Glyph="&#xE93C;" FontSize="32" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Image x:Name="ReleaseCover" Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="ReleaseTitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReleaseArtistText" TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ReleaseDetailsText"
                                FontSize="12"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="EnglishNamesBox" Content="Use English artist names when MusicBrainz has them" />
                    <CheckBox x:Name="CoverArtBox" Content="Save cover art from the Cover Art Archive" />

                    <TextBlock x:Name="MatchSummaryText" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ItemsControl x:Name="MatchList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MbMatchRow">
                                <Grid ColumnSpacing="16" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind MatchText}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1"
                                        Visibility="{x:Bind MatchedVisibility}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind MatchText}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1"
                                        Foreground="{StaticResource AccentRedBrush}"
                                        Visibility="{x:Bind UnmatchedVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Text="Only data from MusicBrainz is written. Genre, lyrics, and comments stay as they are."
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
