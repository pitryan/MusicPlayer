<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MusicPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MusicPlayer">

    <NavigationView
        x:Name="NavView"
        PaneDisplayMode="Left"
        OpenPaneLength="260"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="True"
        IsTitleBarAutoPaddingEnabled="False"
        SelectionChanged="NavView_SelectionChanged">

        <NavigationView.PaneHeader>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,16,0,8">
                <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="{StaticResource AccentRedBrush}" />
                <TextBlock Text="MusicPlayer" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="Library" />
            <NavigationViewItem Content="Songs" Tag="songs">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Audio" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bar atas yang menyatu dengan title bar, seperti Apple Music -->
            <TitleBar
                x:Name="AppTitleBar"
                Height="64"
                Background="{StaticResource TopBarBackgroundBrush}"
                IsBackButtonVisible="False"
                IsPaneToggleButtonVisible="False">

                <TitleBar.LeftHeader>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource TransportButtonStyle}" Click="Previous_Click" ToolTipService.ToolTip="Previous">
                            <SymbolIcon Symbol="Previous" />
                        </Button>
                        <Button Style="{StaticResource TransportButtonStyle}" Click="PlayPause_Click" ToolTipService.ToolTip="Play / Pause">
                            <SymbolIcon Symbol="{x:Bind Playback.PlayPauseSymbol, Mode=OneWay}" />
                        </Button>
                        <Button Style="{StaticResource TransportButtonStyle}" Click="Next_Click" ToolTipService.ToolTip="Next">
                            <SymbolIcon Symbol="Next" />
                        </Button>
                    </StackPanel>
                </TitleBar.LeftHeader>

                <!-- "LCD": cover, judul, artis, dan progres lagu yang sedang diputar -->
                <TitleBar.Content>
                    <Border
                        MinWidth="320"
                        MaxWidth="620"
                        Height="52"
                        HorizontalAlignment="Stretch"
                        CornerRadius="6"
                        Background="{StaticResource LcdBackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Background="{StaticResource CoverPlaceholderBrush}">
                                <FontIcon Glyph="&#xE8D6;" FontSize="20" Foreground="{StaticResource SecondaryTextBrush}" />
                                <Image Source="{x:Bind Playback.CurrentCover, Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid>

                            <Grid Grid.Column="1" Padding="10,5,10,3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Text="{x:Bind Playback.TitleText, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Row="1"
                                    Text="{x:Bind Playback.SubtitleText, Mode=OneWay}"
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <Grid Grid.Row="2" ColumnSpacing="8" VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="{x:Bind Playback.ElapsedText, Mode=OneWay}"
                                        FontSize="10"
                                        Foreground="{StaticResource SecondaryTextBrush}" />

                                    <!-- Area transparen yang lebih tinggi dari garis progres, supaya mudah diklik -->
                                    <Grid
                                        Grid.Column="1"
                                        Height="12"
                                        Background="Transparent"
                                        PointerPressed="SeekBar_PointerPressed">
                                        <ProgressBar
                                            Minimum="0"
                                            Maximum="{x:Bind Playback.DurationSeconds, Mode=OneWay}"
                                            Value="{x:Bind Playback.PositionSeconds, Mode=OneWay}"
                                            Foreground="#CCFFFFFF"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind Playback.RemainingText, Mode=OneWay}"
                                        FontSize="10"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </TitleBar.Content>

                <!-- Mode output: EXCLUSIVE (bit-perfect) atau SHARED -->
                <TitleBar.RightHeader>
                    <TextBlock
                        Text="{x:Bind Playback.StatusText, Mode=OneWay}"
                        FontSize="11"
                        Foreground="{StaticResource AccentRedBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0" />
                </TitleBar.RightHeader>
            </TitleBar>

            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </NavigationView>
</Window>
