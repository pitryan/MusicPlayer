<?xml version="1.0" encoding="utf-8"?>
<!--
    Pengaturan audio di halaman Settings: perangkat output dan exclusive mode. Dibuka juga lewat tombol
    "Audio Quality Settings" di popup badge kualitas. Panel ini hanya berisi baris-baris; kartu dan judul bagiannya
    dibuat oleh SettingsPage.
-->
<UserControl
    x:Class="MusicPlayer.Controls.AudioSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.ViewModels">

    <StackPanel>
        <Grid Padding="0,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Output device" />
                <TextBlock
                    Text="The device that plays your music."
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
            <ComboBox
                x:Name="OutputDeviceCombo"
                Grid.Column="1"
                ItemsSource="{x:Bind Playback.OutputDevices}"
                MinWidth="280"
                MaxWidth="360"
                VerticalAlignment="Center"
                AutomationProperties.Name="Output device"
                SelectionChanged="OutputDeviceCombo_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OutputDeviceItem">
                        <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- Garis pemisah sama dengan kartu di SettingsPage (resource halaman tidak terlihat dari UserControl) -->
        <Border Height="1" Background="#14FFFFFF" />

        <Grid Padding="0,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Exclusive mode" />
                <TextBlock
                    Text="{x:Bind Playback.OutputModeDescription, Mode=OneWay}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                IsOn="{x:Bind Playback.UseExclusiveMode, Mode=TwoWay}"
                OnContent=""
                OffContent=""
                MinWidth="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Exclusive mode" />
        </Grid>
    </StackPanel>
</UserControl>
