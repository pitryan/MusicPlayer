<?xml version="1.0" encoding="utf-8"?>
<!--
    Editor tag (Get Info), untuk satu lagu atau banyak lagu sekaligus (satu album). Field-nya mengikuti tag mapping
    MusicBrainz Picard (lihat TagFields), dikelompokkan per tab seperti jendela Song Info di Apple Music.
-->
<Page
    x:Class="MusicPlayer.Pages.TagEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.ViewModels">

    <Grid Padding="32,24,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kepala: cover kecil, judul, dan tombol Cancel/Save -->
        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                Width="96"
                Height="96"
                CornerRadius="6"
                Background="{StaticResource CoverPlaceholderBrush}">
                <FontIcon Glyph="&#xE8D6;" FontSize="32" Foreground="{StaticResource SecondaryTextBrush}" />
                <Image x:Name="HeaderCover" Stretch="UniformToFill" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="SubtitleText"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="SavingRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                <!-- Isi tag dari MusicBrainz, seperti Lookup di Picard -->
                <Button x:Name="MusicBrainzButton" Content="MusicBrainz…" IsEnabled="False" Click="MusicBrainz_Click" />
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" />
                <Button
                    x:Name="SaveButton"
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    Click="Save_Click" />
            </StackPanel>
        </Grid>

        <!-- Pesan: file yang tidak bisa dibaca atau gagal disimpan -->
        <TextBlock
            x:Name="MessageText"
            Grid.Row="1"
            TextWrapping="Wrap"
            Foreground="{StaticResource AccentRedBrush}"
            Visibility="Collapsed" />

        <SelectorBar x:Name="GroupTabs" Grid.Row="2" SelectionChanged="GroupTabs_SelectionChanged">
            <SelectorBarItem x:Name="DetailsTab" Text="Details" IsSelected="True" />
            <SelectorBarItem x:Name="ReleaseTab" Text="Release" />
            <SelectorBarItem x:Name="CreditsTab" Text="Credits" />
            <SelectorBarItem x:Name="SortingTab" Text="Sorting" />
            <SelectorBarItem x:Name="MusicBrainzTab" Text="MusicBrainz" />
            <SelectorBarItem x:Name="LyricsTab" Text="Lyrics" />
            <SelectorBarItem x:Name="ArtworkTab" Text="Artwork" />
        </SelectorBar>

        <ScrollViewer x:Name="FieldScroller" Grid.Row="3">
            <ItemsControl x:Name="FieldList" Margin="0,8,16,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagFieldRow">
                        <Grid ColumnSpacing="16" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind Label}"
                                Margin="0,6,0,0"
                                VerticalAlignment="Top"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox
                                Grid.Column="1"
                                Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{x:Bind Placeholder}"
                                IsEnabled="{x:Bind IsSupported}"
                                AcceptsReturn="{x:Bind IsLongText}"
                                TextWrapping="Wrap"
                                MinHeight="{x:Bind TextMinHeight}"
                                Visibility="{x:Bind TextVisibility}" />
                            <CheckBox
                                Grid.Column="1"
                                Content="Part of a compilation (various artists)"
                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                IsThreeState="{x:Bind IsMixed}"
                                IsEnabled="{x:Bind IsSupported}"
                                Visibility="{x:Bind CheckVisibility}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Tab Artwork: cover depan, bisa diganti atau dihapus -->
        <StackPanel x:Name="ArtworkPanel" Grid.Row="3" Spacing="12" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid
                Width="260"
                Height="260"
                HorizontalAlignment="Left"
                CornerRadius="8"
                Background="{StaticResource CoverPlaceholderBrush}">
                <TextBlock
                    x:Name="ArtworkStatusText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource SecondaryTextBrush}" />
                <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Choose Image…" Click="ChooseArtwork_Click" />
                <Button x:Name="RemoveArtworkButton" Content="Remove Artwork" Click="RemoveArtwork_Click" />
            </StackPanel>
            <TextBlock
                Text="The new artwork replaces all artwork in the songs you're editing."
                Foreground="{StaticResource SecondaryTextBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
