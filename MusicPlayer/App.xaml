<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MusicPlayer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Mengganti warna bawaan NavigationView (lightweight styling) -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF242424" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF242424" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF1E1E1E" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FFFA2D48" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Palet warna ala Apple Music -->
            <Color x:Key="AccentRedColor">#FFFA2D48</Color>
            <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}" />
            <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="LcdBackgroundBrush" Color="#FF3A3A3A" />
            <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#FF4A4A4A" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#99FFFFFF" />

            <!-- Tombol transport (prev/play/next) tanpa latar dan bingkai -->
            <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
