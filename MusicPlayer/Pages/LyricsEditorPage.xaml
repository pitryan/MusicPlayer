<?xml version="1.0" encoding="utf-8"?>
<!--
    Editor lirik: lirik asli, cara baca, dan terjemahan satu lagu, baris demi baris. Disimpan ke file lagunya (tag
    LYRICS, LYRICS_READING, LYRICS_TRANSLATION), jadi ikut ke mana pun filenya disalin. Teks satu lagu bisa ditempel
    sekaligus ke satu kolom (Paste Reading…, Paste Translation…), atau lirik baru ditempel kalau lagunya belum punya.
-->
<Page
    x:Class="MusicPlayer.Pages.LyricsEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.ViewModels">
    <Grid Padding="40,28,40,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Edit Lyrics" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Paste Lyrics…" Click="PasteLyrics_Click" ToolTipService.ToolTip="Replace the lyrics with pasted text: plain lines, or .lrc with time tags" />
            <Button x:Name="PasteReadingButton" Content="Paste Reading…" Click="PasteReading_Click" ToolTipService.ToolTip="Fill the Reading column from pasted text, one line per lyric line" />
            <Button x:Name="PasteTranslationButton" Content="Paste Translation…" Click="PasteTranslation_Click" ToolTipService.ToolTip="Fill the Translation column from pasted text, one line per lyric line" />
            <ProgressRing x:Name="LoadingRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Judul kolom; lebar kolomnya sama dengan template baris di bawah -->
        <Grid Grid.Row="2" ColumnSpacing="10" Padding="12,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Time" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Grid.Column="1" Text="Lyrics" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Grid.Column="2" Text="Reading" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Grid.Column="3" Text="Translation" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
        </Grid>

        <ListView x:Name="RowsList" Grid.Row="3" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,3" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LyricEditRow">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind TimeText}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox Grid.Column="1" Text="{x:Bind Original, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="(instrumental break)" />
                        <TextBox Grid.Column="2" Text="{x:Bind Reading, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="3" Text="{x:Bind Translation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="MessageText"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="Saved into the song file, so the reading and translation go wherever the file goes." />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ProgressRing x:Name="SavingRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" />
                <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" Content="Save" IsEnabled="False" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
