<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MusicPlayer.Pages.ArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.ViewModels"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
    </Page.Resources>

    <!-- Dua kolom seperti Apple Music: daftar artis di kiri, detail artis yang dipilih di kanan -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView
            x:Name="ArtistList"
            Padding="8,12,8,12"
            BorderThickness="0,0,1,0"
            BorderBrush="#1FFFFFFF"
            SelectionMode="Single"
            SelectionChanged="ArtistList_SelectionChanged"
            ContainerContentChanging="ArtistList_ContainerContentChanging">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ArtistItem">
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                        <!-- Foto bulat: placeholder abu-abu, tertutup cover saat sudah dimuat -->
                        <Grid Width="40" Height="40">
                            <Ellipse Fill="{StaticResource CoverPlaceholderBrush}" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <TextBlock
                            Text="{x:Bind Name}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="180" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer x:Name="DetailScroller" Grid.Column="1">
            <StackPanel Padding="40,28,32,40">
                <!-- Nama artis membuka halaman artisnya, seperti "Aaron Kwok ›" di Apple Music -->
                <Button
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Left"
                    ToolTipService.ToolTip="Go to Artist"
                    Click="ArtistName_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="ArtistNameText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <FontIcon Glyph="&#xE76C;" FontSize="18" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="ArtistCountText" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,32">
                    <Button Style="{StaticResource AccentButtonStyle}" Padding="20,6" Click="Play_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Play" />
                            <TextBlock Text="Play" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Padding="20,6" Click="Shuffle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Shuffle" />
                            <TextBlock Text="Shuffle" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Setiap album: cover di kiri, daftar lagu di kanan. Klik dua kali sebuah lagu untuk memutarnya -->
                <ItemsRepeater
                    x:Name="AlbumRepeater"
                    DoubleTapped="AlbumRepeater_DoubleTapped"
                    RightTapped="AlbumRepeater_RightTapped">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:AlbumBlock">
                            <Grid ColumnSpacing="28" Margin="0,0,0,40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Cover bisa diklik untuk membuka halaman albumnya -->
                                <Grid
                                    Width="180"
                                    Height="180"
                                    VerticalAlignment="Top"
                                    CornerRadius="6"
                                    Background="{StaticResource CoverPlaceholderBrush}"
                                    Tapped="AlbumCover_Tapped">
                                    <FontIcon Glyph="&#xE93C;" FontSize="40" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <Border CornerRadius="6">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind Meta}"
                                        FontSize="12"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        Margin="0,2,0,12" />

                                    <ItemsControl ItemsSource="{x:Bind Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TrackRow">
                                                <Grid
                                                    Height="38"
                                                    ColumnSpacing="16"
                                                    Padding="12,0"
                                                    CornerRadius="4"
                                                    Background="{x:Bind RowBackground}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="48" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Bintang merah untuk lagu favorit, di kiri nomor track seperti Apple Music -->
                                                    <FontIcon
                                                        Glyph="&#xE735;"
                                                        FontSize="10"
                                                        Foreground="{StaticResource AccentRedBrush}"
                                                        Visibility="{x:Bind FavouriteVisibility, Mode=OneWay}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        Text="{x:Bind NumberText}"
                                                        Visibility="{x:Bind NumberVisibility, Mode=OneWay}"
                                                        Style="{StaticResource CellStyle}"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        HorizontalAlignment="Right" />
                                                    <FontIcon
                                                        Glyph="&#xE768;"
                                                        FontSize="12"
                                                        Foreground="{StaticResource AccentRedBrush}"
                                                        Visibility="{x:Bind PlayingVisibility, Mode=OneWay}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource CellStyle}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{x:Bind DurationText}"
                                                        Style="{StaticResource CellStyle}"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            x:Name="EmptyState"
            Grid.ColumnSpan="2"
            Visibility="Collapsed"
            Spacing="8"
            Margin="0,48,0,0"
            HorizontalAlignment="Center">
            <TextBlock Text="No artists yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="Add a music folder in Settings (the gear icon at the bottom left)."
                Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</Page>
