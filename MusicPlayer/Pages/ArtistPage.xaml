<?xml version="1.0" encoding="utf-8"?>
<!--
    Halaman artis seperti Apple Music: banner lebar (cover rilis terbaru; foto artis dari internet terlalu buram) dengan
    tombol Play dan nama artis di kiri bawah; Latest Release dan Top Songs berdampingan; lalu rak Albums, Singles & EPs,
    dan Appears On. Bagian yang kosong disembunyikan.
-->
<Page
    x:Class="MusicPlayer.Pages.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.ViewModels"
    xmlns:controls="using:MusicPlayer.Controls">

    <Page.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel>
            <!-- Banner: tingginya mengikuti lebar halaman (Banner_SizeChanged) -->
            <Grid x:Name="Banner" Height="420" Background="{StaticResource CoverPlaceholderBrush}" SizeChanged="Banner_SizeChanged">
                <Image x:Name="BannerImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Gradasi gelap di bawah, supaya nama dan tombol tetap terbaca di atas gambar apa pun -->
                <Rectangle Height="220" VerticalAlignment="Bottom">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#B3000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,200,28">
                    <Button x:Name="PlayButton" Style="{StaticResource BannerPlayButtonStyle}" ToolTipService.ToolTip="Play" Click="Play_Click">
                        <Viewbox Width="16" Height="16" Margin="2,0,0,0">
                            <PathIcon Data="F1 M17.2221 8.68458C18.2586 9.25438 18.2586 10.7437 17.2221 11.3135L7.22259 16.8105C6.22292 17.36 5 16.6367 5 15.496L5 4.50214C5 3.36137 6.22292 2.63812 7.22259 3.18766L17.2221 8.68458Z" />
                        </Viewbox>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" FontSize="30" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="MetaText" FontSize="12" Foreground="#CCFFFFFF" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,30">
                    <Button x:Name="ShuffleButton" Style="{StaticResource BannerCircleButtonStyle}" ToolTipService.ToolTip="Shuffle" Click="Shuffle_Click">
                        <Viewbox Width="16" Height="16">
                            <PathIcon Data="F1 M15.7803 3.71967C15.4874 3.42678 15.0126 3.42678 14.7197 3.71967C14.4268 4.01256 14.4268 4.48744 14.7197 4.78033L15.4735 5.53419C12.3828 5.81153 10.5945 7.72788 8.99886 9.43788L8.9517 9.48841C7.18821 11.3779 5.6408 13.0002 2.75 13.0002C2.33579 13.0002 2 13.336 2 13.7502C2 14.1645 2.33579 14.5002 2.75 14.5002C6.32656 14.5002 8.27635 12.4108 10.0011 10.5624L10.0483 10.5119C11.628 8.81932 13.0343 7.34116 15.388 7.05139L14.7197 7.71975C14.4268 8.01265 14.4268 8.48752 14.7197 8.78041C15.0126 9.07331 15.4874 9.07331 15.7803 8.78041L17.7804 6.78037C18.0733 6.48748 18.0733 6.0126 17.7804 5.71971L15.7803 3.71967ZM2.75 5.50024C5.52864 5.50024 7.32539 6.76133 8.79759 8.19071C8.63182 8.36517 8.47131 8.53728 8.31508 8.70481L8.22064 8.80606C8.06689 8.97079 7.9169 9.13088 7.76961 9.2859C6.41908 7.97133 4.98663 7.00024 2.75 7.00024C2.33579 7.00024 2 6.66446 2 6.25024C2 5.83603 2.33579 5.50024 2.75 5.50024ZM15.4735 14.4658C13.1281 14.2554 11.5327 13.1011 10.2024 11.8095C10.3682 11.635 10.5288 11.4628 10.685 11.2953L10.7794 11.1941C10.9331 11.0294 11.0831 10.8693 11.2304 10.7143C12.399 11.8518 13.6289 12.7321 15.388 12.9486L14.7197 12.2802C14.4268 11.9874 14.4268 11.5125 14.7197 11.2196C15.0126 10.9267 15.4874 10.9267 15.7803 11.2196L17.7804 13.2196C18.0733 13.5125 18.0733 13.9874 17.7804 14.2803L15.7803 16.2803C15.4874 16.5732 15.0126 16.5732 14.7197 16.2803C14.4268 15.9874 14.4268 15.5126 14.7197 15.2197L15.4735 14.4658Z" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource BannerCircleButtonStyle}" ToolTipService.ToolTip="More" Click="ArtistMore_Click">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Padding="40,32,40,48" Spacing="40">
                <!-- Latest Release di kiri, Top Songs di kanan -->
                <Grid x:Name="HighlightsRow" ColumnSpacing="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="LatestPanel" Spacing="14">
                        <TextBlock Text="Latest Release" Style="{StaticResource SectionTitleStyle}" />
                        <Button Style="{StaticResource TileButtonStyle}" ToolTipService.ToolTip="Open album" Click="Latest_Click">
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <Border
                                    Width="165"
                                    Height="165"
                                    CornerRadius="6"
                                    Background="{StaticResource CoverPlaceholderBrush}"
                                    PointerEntered="Tile_PointerEntered"
                                    PointerExited="Tile_PointerExited">
                                    <Border.Child>
                                        <Border CornerRadius="6">
                                            <Border.Background>
                                                <ImageBrush x:Name="LatestCoverBrush" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Border.Child>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Width="190" Spacing="3">
                                    <TextBlock
                                        x:Name="LatestDateText"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="LatestTitleText" FontSize="15" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="LatestInfoText" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--
                        Top Songs: tiga baris per kolom, digulir mendatar dengan panah seperti Apple Music. Lebar kolom
                        sepertiga lebar yang terlihat (TopSongsScroller_SizeChanged). Item dibawa lewat Tag, karena
                        ItemsRepeater tidak mengisi DataContext untuk template x:Bind.
                    -->
                    <StackPanel x:Name="TopSongsPanel" Grid.Column="1" Spacing="14">
                        <TextBlock Text="Top Songs" Style="{StaticResource SectionTitleStyle}" />
                        <Grid>
                            <ScrollViewer
                                x:Name="TopSongsScroller"
                                HorizontalScrollMode="Enabled"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Disabled"
                                SizeChanged="TopSongsScroller_SizeChanged">
                                <ItemsRepeater x:Name="TopSongsRepeater">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            x:Name="TopSongsLayout"
                                            Orientation="Vertical"
                                            MaximumRowsOrColumns="3"
                                            MinItemWidth="300"
                                            MinItemHeight="62"
                                            MinColumnSpacing="24"
                                            MinRowSpacing="0" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TrackRow">
                                            <Grid
                                                Height="62"
                                                ColumnSpacing="12"
                                                Background="Transparent"
                                                Tag="{x:Bind}"
                                                DoubleTapped="TopSong_DoubleTapped"
                                                RightTapped="TopSong_RightTapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Garis tipis di atas setiap lagu, seperti Apple Music -->
                                                <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" Fill="#1FFFFFFF" />
                                                <Grid Width="40" Height="40" CornerRadius="4" Background="{StaticResource CoverPlaceholderBrush}">
                                                    <Border CornerRadius="4">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                    <!-- Lagu yang sedang diputar: cover digelapkan, dengan batang putih yang bergerak -->
                                                    <Border
                                                        x:Name="PlayingOverlay"
                                                        x:Load="{x:Bind IsPlaying, Mode=OneWay}"
                                                        Background="#99000000"
                                                        CornerRadius="4">
                                                        <controls:PlayingBars Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon
                                                            Glyph="&#xE735;"
                                                            FontSize="9"
                                                            Foreground="{StaticResource AccentRedBrush}"
                                                            Visibility="{x:Bind FavouriteVisibility, Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Text="{x:Bind AlbumYearText}"
                                                        FontSize="12"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        TextTrimming="CharacterEllipsis"
                                                        MaxLines="1" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    Padding="6,2"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="More"
                                                    Tag="{x:Bind}"
                                                    Click="TopSongMore_Click">
                                                    <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{StaticResource AccentRedBrush}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                            <Button
                                x:Name="TopSongsLeft"
                                Style="{StaticResource ShelfArrowButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="-18,75,0,0"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="Previous">
                                <FontIcon Glyph="&#xE76B;" FontSize="14" />
                            </Button>
                            <Button
                                x:Name="TopSongsRight"
                                Style="{StaticResource ShelfArrowButtonStyle}"
                                HorizontalAlignment="Right"
                                Margin="0,75,-18,0"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="Next">
                                <FontIcon Glyph="&#xE76C;" FontSize="14" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <controls:AlbumShelf x:Name="AlbumsShelf" Title="Albums" ItemInvoked="Release_ItemInvoked" />
                <controls:AlbumShelf x:Name="SinglesShelf" Title="Singles &amp; EPs" ItemInvoked="Release_ItemInvoked" />
                <controls:AlbumShelf x:Name="AppearsOnShelf" Title="Appears On" ItemInvoked="Release_ItemInvoked" />

                <!--
                    About, seperti Apple Music: teks dari Wikipedia (dengan tautan sumbernya, karena lisensinya CC BY-SA)
                    di kiri; asal, tanggal lahir atau terbentuk, dan genre di kanan. Disembunyikan kalau belum ada datanya.
                -->
                <Grid x:Name="AboutSection" ColumnSpacing="56" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="680" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="AboutTitle" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock
                            x:Name="AboutText"
                            FontSize="13"
                            LineHeight="20"
                            TextWrapping="Wrap"
                            TextTrimming="WordEllipsis"
                            MaxLines="8"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <HyperlinkButton x:Name="AboutMoreButton" Content="More" Padding="0" Click="AboutMore_Click" />
                            <HyperlinkButton x:Name="AboutSourceLink" Content="From Wikipedia" Padding="0" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="14" Margin="0,38,0,0" MinWidth="200">
                        <StackPanel x:Name="FromPanel">
                            <TextBlock Text="FROM" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="FromText" FontSize="14" />
                        </StackPanel>
                        <StackPanel x:Name="BornPanel">
                            <TextBlock x:Name="BornLabel" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="BornText" FontSize="14" />
                        </StackPanel>
                        <StackPanel x:Name="GenrePanel">
                            <TextBlock Text="GENRE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="GenreText" FontSize="14" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--
                    Similar Artists: dihitung dari library sendiri (kolaborasi, sering didengar berdekatan, genre yang
                    sama). Item dibawa lewat Tag, karena ItemsRepeater tidak mengisi DataContext untuk template x:Bind.
                -->
                <StackPanel x:Name="SimilarSection" Spacing="14" Visibility="Collapsed">
                    <TextBlock Text="Similar Artists" Style="{StaticResource SectionTitleStyle}" />
                    <Grid>
                        <ScrollViewer
                            x:Name="SimilarScroller"
                            HorizontalScrollMode="Enabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Disabled">
                            <ItemsRepeater x:Name="SimilarRepeater">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="24" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ArtistItem">
                                        <Button Style="{StaticResource TileButtonStyle}" Width="136" Tag="{x:Bind}" Click="SimilarArtist_Click">
                                            <StackPanel Spacing="8">
                                                <Grid Width="136" Height="136" PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                                                    <Ellipse Fill="{StaticResource CoverPlaceholderBrush}" />
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <TextBlock
                                                    Text="{x:Bind Name}"
                                                    FontSize="13"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap"
                                                    MaxLines="2"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                        <Button
                            x:Name="SimilarLeft"
                            Style="{StaticResource ShelfArrowButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="-14,50,0,0"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Previous">
                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="SimilarRight"
                            Style="{StaticResource ShelfArrowButtonStyle}"
                            HorizontalAlignment="Right"
                            Margin="0,50,-14,0"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Next">
                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
