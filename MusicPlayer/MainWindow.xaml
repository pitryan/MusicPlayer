<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MusicPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicPlayer.Controls"
    xmlns:vm="using:MusicPlayer.ViewModels"
    xmlns:helpers="using:MusicPlayer.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MusicPlayer">

    <NavigationView
        x:Name="NavView"
        PaneDisplayMode="Left"
        OpenPaneLength="260"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        ItemInvoked="NavView_ItemInvoked">

        <!-- Warna NavigationView diganti langsung di kontrolnya (lightweight styling) -->
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF242424" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF242424" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF1E1E1E" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FFFA2D48" />
        </NavigationView.Resources>

        <!--
            Kepala sidebar seperti Apple Music: logo dan nama aplikasi sejajar dengan bar atas, tombol ••• (Settings,
            MiniPlayer, layar penuh) di kanan, kotak pencarian tepat di bawahnya. Tombol back ada di kiri atas halaman.
        -->
        <NavigationView.PaneHeader>
            <Grid Width="260" Height="48" Padding="16,8,8,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Logo aplikasi (lima batang gelombang, sama dengan ikon aplikasi) -->
                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                    <PathIcon Data="F1 M0.9,8.3 A1.3,1.3 0 0 1 3.5,8.3 V11.7 A1.3,1.3 0 0 1 0.9,11.7 Z M4.8,5.8 A1.3,1.3 0 0 1 7.4,5.8 V14.2 A1.3,1.3 0 0 1 4.8,14.2 Z M8.7,3.3 A1.3,1.3 0 0 1 11.3,3.3 V16.7 A1.3,1.3 0 0 1 8.7,16.7 Z M12.6,5.8 A1.3,1.3 0 0 1 15.2,5.8 V14.2 A1.3,1.3 0 0 1 12.6,14.2 Z M16.5,8.3 A1.3,1.3 0 0 1 19.1,8.3 V11.7 A1.3,1.3 0 0 1 16.5,11.7 Z" Foreground="{StaticResource AccentRedBrush}" />
                </Viewbox>
                <TextBlock Grid.Column="1" Text="MusicPlayer" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button
                    Grid.Column="2"
                    Padding="8,4"
                    MinWidth="0"
                    MinHeight="0"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="More"
                    ToolTipService.ToolTip="More">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Settings" Click="SettingsMenu_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE713;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="MiniPlayer" Click="MiniPlayerMenu_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE944;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Full Screen Player" Click="FullScreenMenu_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE740;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </NavigationView.PaneHeader>

        <NavigationView.AutoSuggestBox>
            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="Search"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged"
                QuerySubmitted="SearchBox_QuerySubmitted" />
        </NavigationView.AutoSuggestBox>

        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="Library" />
            <NavigationViewItem Content="Recently Added" Tag="recent">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE823;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Recently Played" Tag="recentlyplayed">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Most Played" Tag="mostplayed">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8E1;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Artists" Tag="artists">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Albums" Tag="albums">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE93C;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Songs" Tag="songs">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Audio" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Genres" Tag="genres">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8EC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <!-- Pemeriksaan kualitas sumber: hi-res hasil upsampling, lossless dari MP3/AAC -->
            <NavigationViewItem Content="Quality Check" Tag="quality">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <!-- Playlists, seperti Apple Music. Playlist buatan sendiri dan "New Playlist" ditambahkan dari kode
                 (RefreshPlaylistItems) tepat di bawah Favourite Songs. -->
            <NavigationViewItemHeader Content="Playlists" />
            <NavigationViewItem Content="All Playlists" Tag="playlists">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8F1;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Favourite Songs" Tag="favourites">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE734;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <!-- Grup "Folders" ditambahkan dari kode (RefreshFolderItems), karena isinya mengikuti Settings -->
        </NavigationView.MenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Bar atas yang menyatu dengan title bar. Area kosongnya dipakai untuk menggeser jendela;
                area yang bisa diklik (tombol dan LCD) dikecualikan lewat kode di MainWindow.xaml.cs.
                Kolom tengah (LCD) maksimal 600 px dan selalu di tengah; kalau jendela sempit, LCD ikut menyusut.
            -->
            <Grid
                x:Name="TopBar"
                Background="{StaticResource TopBarBackgroundBrush}"
                BorderBrush="#1FFFFFFF"
                BorderThickness="0,0,0,1"
                SizeChanged="TopBar_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="3*" MaxWidth="640" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition x:Name="CaptionButtonsColumn" Width="138" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="TransportPanel"
                    Orientation="Horizontal"
                    Spacing="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <!--
                        Shuffle dan repeat menyala merah saat aktif, sama seperti tombol antrean. Ikonnya versi tebal dari
                        Fluent UI System Icons (Microsoft, lisensi MIT), serasi dengan tombol di TransportButtons.
                    -->
                    <ToggleButton
                        x:Name="ShuffleToggle"
                        Padding="8"
                        MinWidth="40"
                        MinHeight="40"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{x:Bind Playback.IsShuffle, Mode=OneWay}"
                        Click="ShuffleToggle_Click"
                        ToolTipService.ToolTip="Shuffle">
                        <PathIcon Data="F1 M15.7803 3.71967C15.4874 3.42678 15.0126 3.42678 14.7197 3.71967C14.4268 4.01256 14.4268 4.48744 14.7197 4.78033L15.4735 5.53419C12.3828 5.81153 10.5945 7.72788 8.99886 9.43788L8.9517 9.48841C7.18821 11.3779 5.6408 13.0002 2.75 13.0002C2.33579 13.0002 2 13.336 2 13.7502C2 14.1645 2.33579 14.5002 2.75 14.5002C6.32656 14.5002 8.27635 12.4108 10.0011 10.5624L10.0483 10.5119C11.628 8.81932 13.0343 7.34116 15.388 7.05139L14.7197 7.71975C14.4268 8.01265 14.4268 8.48752 14.7197 8.78041C15.0126 9.07331 15.4874 9.07331 15.7803 8.78041L17.7804 6.78037C18.0733 6.48748 18.0733 6.0126 17.7804 5.71971L15.7803 3.71967ZM2.75 5.50024C5.52864 5.50024 7.32539 6.76133 8.79759 8.19071C8.63182 8.36517 8.47131 8.53728 8.31508 8.70481L8.22064 8.80606C8.06689 8.97079 7.9169 9.13088 7.76961 9.2859C6.41908 7.97133 4.98663 7.00024 2.75 7.00024C2.33579 7.00024 2 6.66446 2 6.25024C2 5.83603 2.33579 5.50024 2.75 5.50024ZM15.4735 14.4658C13.1281 14.2554 11.5327 13.1011 10.2024 11.8095C10.3682 11.635 10.5288 11.4628 10.685 11.2953L10.7794 11.1941C10.9331 11.0294 11.0831 10.8693 11.2304 10.7143C12.399 11.8518 13.6289 12.7321 15.388 12.9486L14.7197 12.2802C14.4268 11.9874 14.4268 11.5125 14.7197 11.2196C15.0126 10.9267 15.4874 10.9267 15.7803 11.2196L17.7804 13.2196C18.0733 13.5125 18.0733 13.9874 17.7804 14.2803L15.7803 16.2803C15.4874 16.5732 15.0126 16.5732 14.7197 16.2803C14.4268 15.9874 14.4268 15.5126 14.7197 15.2197L15.4735 14.4658Z" />
                    </ToggleButton>
                    <controls:TransportButtons />
                    <ToggleButton
                        x:Name="RepeatToggle"
                        Padding="8"
                        MinWidth="40"
                        MinHeight="40"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{x:Bind Playback.IsRepeatOn, Mode=OneWay}"
                        Click="RepeatToggle_Click"
                        ToolTipService.ToolTip="Repeat: off, all, or one">
                        <Grid>
                            <PathIcon
                                Data="F1 M15.7505 6.01C15.9298 6.01 16.0944 6.07292 16.2234 6.17788C17.3113 7.09184 18.0029 8.46516 18.0029 10C18.0029 12.6888 15.8806 14.8818 13.2198 14.9954L13.0029 15H8.56105L9.7808 16.2197C10.0471 16.4859 10.0713 16.9026 9.85341 17.1962L9.7808 17.2803C9.51453 17.5466 9.09787 17.5708 8.80425 17.3529L8.72014 17.2803L6.22014 14.7803C5.95387 14.5141 5.92966 14.0974 6.14752 13.8038L6.22014 13.7197L8.72014 11.2197C9.01303 10.9268 9.4879 10.9268 9.7808 11.2197C10.0471 11.4859 10.0713 11.9026 9.85341 12.1962L9.7808 12.2803L8.56105 13.5H13.0029C14.8714 13.5 16.398 12.0357 16.4977 10.192L16.5029 10C16.5029 8.91885 16.0127 7.95219 15.2424 7.31017C15.094 7.17538 15.0005 6.97861 15.0005 6.76C15.0005 6.34579 15.3363 6.01 15.7505 6.01ZM10.2201 2.71967C10.4864 2.4534 10.9031 2.4292 11.1967 2.64705L11.2808 2.71967L13.7808 5.21967L13.8534 5.30379C14.0471 5.56478 14.0495 5.92299 13.8606 6.18638L13.7808 6.28033L11.2808 8.78033L11.1967 8.85295C10.9357 9.0466 10.5775 9.04899 10.3141 8.86012L10.2201 8.78033L10.1475 8.69621C9.95387 8.43522 9.95148 8.07701 10.1403 7.81362L10.2201 7.71967L11.439 6.5H6.99805C5.12948 6.5 3.60292 7.96428 3.50323 9.80796L3.49805 10C3.49805 11.0831 3.99006 12.0514 4.76278 12.6934C4.90897 12.8289 5.00047 13.0238 5.00047 13.24C5.00047 13.6542 4.66468 13.99 4.25047 13.99C4.05918 13.99 3.88462 13.9184 3.75213 13.8005C2.67913 12.8872 1.99805 11.5232 1.99805 10C1.99805 7.31125 4.12035 5.11818 6.78116 5.00462L6.99805 5H11.439L10.2201 3.78033L10.1475 3.69621C9.92966 3.4026 9.95387 2.98594 10.2201 2.71967Z"
                                Visibility="{x:Bind helpers:Formatters.CollapsedIf(Playback.IsRepeatOne), Mode=OneWay}" />
                            <PathIcon
                                Data="F1 M15.7524 6.01C15.9317 6.01 16.0963 6.07292 16.2254 6.17788C17.3133 7.09184 18.0048 8.46516 18.0048 10C18.0048 10.1979 17.9933 10.3931 17.971 10.585C17.5142 10.3549 17.0211 10.1866 16.5024 10.0911L16.5048 10C16.5048 8.91885 16.0146 7.95219 15.2444 7.31017C15.096 7.17538 15.0024 6.97861 15.0024 6.76C15.0024 6.34579 15.3382 6.01 15.7524 6.01ZM10.3749 13.5C10.1907 13.9718 10.0697 14.4753 10.0224 15H8.563L9.78275 16.2197C10.049 16.4859 10.0732 16.9026 9.85537 17.1962L9.78275 17.2803C9.51648 17.5466 9.09982 17.5708 8.80621 17.3529L8.72209 17.2803L6.22209 14.7803C5.95582 14.5141 5.93162 14.0974 6.14947 13.8038L6.22209 13.7197L8.72209 11.2197C9.01498 10.9268 9.48986 10.9268 9.78275 11.2197C10.049 11.4859 10.0732 11.9026 9.85537 12.1962L9.78275 12.2803L8.563 13.5H10.3749ZM10.2221 2.71967C10.4884 2.4534 10.905 2.4292 11.1986 2.64705L11.2827 2.71967L13.7827 5.21967L13.8554 5.30379C14.049 5.56478 14.0514 5.92299 13.8625 6.18638L13.7827 6.28033L11.2827 8.78033L11.1986 8.85295C10.9376 9.0466 10.5794 9.04899 10.316 8.86012L10.2221 8.78033L10.1495 8.69621C9.95582 8.43522 9.95343 8.07701 10.1423 7.81362L10.2221 7.71967L11.441 6.5H7C5.13144 6.5 3.60487 7.96428 3.50518 9.80796L3.5 10C3.5 11.0831 3.99201 12.0514 4.76473 12.6934C4.91093 12.8289 5.00242 13.0238 5.00242 13.24C5.00242 13.6542 4.66663 13.99 4.25242 13.99C4.06113 13.99 3.88657 13.9184 3.75408 13.8005C2.68108 12.8872 2 11.5232 2 10C2 7.31125 4.12231 5.11818 6.78311 5.00462L7 5H11.441L10.2221 3.78033L10.1495 3.69621C9.93162 3.4026 9.95582 2.98594 10.2221 2.71967ZM20 15.5C20 17.9853 17.9853 20 15.5 20C13.0147 20 11 17.9853 11 15.5C11 13.0147 13.0147 11 15.5 11C17.9853 11 20 13.0147 20 15.5ZM16.0477 12.8386C15.8633 12.7864 15.5572 12.8034 15.3683 13.0719C15.1551 13.3751 14.7871 13.7975 14.2764 14.0528C14.0294 14.1763 13.9293 14.4766 14.0528 14.7236C14.1763 14.9706 14.4766 15.0707 14.7236 14.9472C15.0229 14.7976 15.2814 14.6114 15.5 14.4182V17.5C15.5 17.7761 15.7239 18 16 18C16.2761 18 16.5 17.7761 16.5 17.5V13.4236C16.5 13.0752 16.2327 12.891 16.0477 12.8386Z"
                                Visibility="{x:Bind helpers:Formatters.VisibleIf(Playback.IsRepeatOne), Mode=OneWay}" />
                        </Grid>
                    </ToggleButton>
                </StackPanel>

                <!-- "LCD": cover, badge kualitas, judul dan artis (bergeser kalau kepanjangan), progres -->
                <Border
                    x:Name="LcdBorder"
                    Grid.Column="1"
                    RightTapped="LcdBorder_RightTapped"
                    PointerEntered="LcdBorder_PointerEntered"
                    PointerExited="LcdBorder_PointerExited"
                    Height="52"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    Background="{StaticResource LcdBackgroundBrush}"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="1">
                    <!-- Isi LCD: memudar masuk setiap kali lagu berganti -->
                    <Grid x:Name="LcdContent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Arahkan kursor ke cover: cover diburamkan dan ikon MiniPlayer muncul. Klik untuk membuka MiniPlayer. -->
                        <Grid
                            Background="{StaticResource CoverPlaceholderBrush}"
                            CornerRadius="6,0,0,6"
                            ToolTipService.ToolTip="MiniPlayer"
                            PointerEntered="LcdCover_PointerEntered"
                            PointerExited="LcdCover_PointerExited"
                            Tapped="LcdCover_Tapped">
                            <FontIcon Glyph="&#xE8D6;" FontSize="20" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Border CornerRadius="6,0,0,6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind Playback.CurrentCover, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <!-- Acrylic memburamkan cover di belakangnya. Ikon: Fluent UI System Icons (MIT). -->
                            <Grid x:Name="LcdCoverOverlay" CornerRadius="6,0,0,6" Visibility="Collapsed">
                                <Grid.Background>
                                    <AcrylicBrush TintColor="#FF000000" TintOpacity="0.35" FallbackColor="#B3000000" />
                                </Grid.Background>
                                <PathIcon Data="F1 M2 5.75C2 4.23122 3.23122 3 4.75 3H15.25C16.7688 3 18 4.23122 18 5.75V10H17V5.75C17 4.7835 16.2165 4 15.25 4H4.75C3.7835 4 3 4.7835 3 5.75V12.25C3 13.2165 3.7835 14 4.75 14H9V15H4.75C3.23122 15 2 13.7688 2 12.25V5.75ZM11.5 11C10.6716 11 10 11.6716 10 12.5V16.5C10 17.3284 10.6716 18 11.5 18H17.5C18.3284 18 19 17.3284 19 16.5V12.5C19 11.6716 18.3284 11 17.5 11H11.5Z" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <!-- Tanpa lagu: logo aplikasi di tengah LCD, seperti Apple Music -->
                        <Viewbox
                            Grid.Column="1"
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind helpers:Formatters.VisibleIfNull(Playback.CurrentTrack), Mode=OneWay}">
                            <PathIcon Data="F1 M0.9,8.3 A1.3,1.3 0 0 1 3.5,8.3 V11.7 A1.3,1.3 0 0 1 0.9,11.7 Z M4.8,5.8 A1.3,1.3 0 0 1 7.4,5.8 V14.2 A1.3,1.3 0 0 1 4.8,14.2 Z M8.7,3.3 A1.3,1.3 0 0 1 11.3,3.3 V16.7 A1.3,1.3 0 0 1 8.7,16.7 Z M12.6,5.8 A1.3,1.3 0 0 1 15.2,5.8 V14.2 A1.3,1.3 0 0 1 12.6,14.2 Z M16.5,8.3 A1.3,1.3 0 0 1 19.1,8.3 V11.7 A1.3,1.3 0 0 1 16.5,11.7 Z" Foreground="{StaticResource AccentRedBrush}" />
                        </Viewbox>

                        <!--
                            Lega seperti Apple Music: dua baris (judul dan artis) di tengah, badge kecil di kiri, tombol •••
                            di kanan. Garis progres tipis menempel di tepi bawah; waktu baru muncul saat kursor di atas LCD.
                        -->
                        <Grid Grid.Column="1" Visibility="{x:Bind helpers:Formatters.CollapsedIfNull(Playback.CurrentTrack), Mode=OneWay}">
                            <Grid Padding="8,5,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Badge kualitas; diklik untuk melihat detail format dan jalur output -->
                                <controls:QualityBadge HorizontalAlignment="Left" VerticalAlignment="Center" IsCompact="True" />
                                <controls:MarqueeText
                                    Grid.Column="1"
                                    Text="{x:Bind Playback.TitleText, Mode=OneWay}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                                <!-- Menu yang sama dengan klik kanan di LCD -->
                                <Button
                                    x:Name="LcdMoreButton"
                                    Grid.Column="2"
                                    Padding="6,0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="More"
                                    Visibility="{x:Bind Playback.QualityVisibility, Mode=OneWay}"
                                    Click="LcdMore_Click">
                                    <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{StaticResource AccentRedBrush}" />
                                </Button>
                                <!-- Bintang favorit di ujung kanan, seperti Apple Music: kosong, atau merah kalau favorit -->
                                <Button
                                    x:Name="LcdFavouriteButton"
                                    Grid.Column="2"
                                    Padding="6,0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Favourite"
                                    Visibility="{x:Bind Playback.QualityVisibility, Mode=OneWay}"
                                    Click="LcdFavourite_Click">
                                    <Grid>
                                        <FontIcon
                                            x:Name="LcdStarOutline"
                                            Glyph="&#xE734;"
                                            FontSize="12"
                                            Foreground="{StaticResource SecondaryTextBrush}" />
                                        <FontIcon
                                            x:Name="LcdStarFilled"
                                            Glyph="&#xE735;"
                                            FontSize="12"
                                            Foreground="{StaticResource AccentRedBrush}"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                                <controls:MarqueeText
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{x:Bind Playback.SubtitleText, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="LcdElapsedText"
                                    Grid.Row="1"
                                    Text="{x:Bind Playback.ElapsedText, Mode=OneWay}"
                                    FontSize="10"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="LcdRemainingText"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Text="{x:Bind Playback.RemainingText, Mode=OneWay}"
                                    FontSize="10"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed" />
                            </Grid>
                            <!-- Garis progres tipis di tepi bawah. Area kliknya lebih tinggi dari garisnya, supaya mudah diklik. -->
                            <Grid
                                Height="10"
                                VerticalAlignment="Bottom"
                                Background="Transparent"
                                PointerPressed="SeekBar_PointerPressed">
                                <ProgressBar
                                    Minimum="0"
                                    Maximum="{x:Bind Playback.DurationSeconds, Mode=OneWay}"
                                    Value="{x:Bind Playback.PositionSeconds, Mode=OneWay}"
                                    Foreground="#CCFFFFFF"
                                    VerticalAlignment="Bottom" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!--
                    Kanan atas: volume dan tombol panel lirik serta antrean di tengah ruang antara LCD dan tombol jendela.
                    Pesan error (kalau ada) di sebelah kirinya.
                -->
                <Grid Grid.Column="2" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Pesan yang terpotong bisa dibaca utuh lewat tooltip. Rata kanan dan selebar teksnya,
                         supaya saat tidak ada pesan, tidak ada area kosong yang memunculkan tooltip kosong. -->
                    <TextBlock
                        Text="{x:Bind Playback.StatusText, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Playback.StatusText, Mode=OneWay}"
                        FontSize="11"
                        Foreground="{StaticResource AccentRedBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextAlignment="Right"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0" />
                    <StackPanel
                        x:Name="RightButtonsPanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <controls:VolumeButton />
                        <!-- Panel lirik dan panel Playing Next berbagi tempat di kanan; tombol yang menyala menunjukkan
                             panel mana yang terbuka. Ikon: comment_quote dari Fluent UI System Icons (MIT). -->
                        <ToggleButton
                            x:Name="LyricsToggle"
                            Padding="8"
                            MinWidth="40"
                            MinHeight="40"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Lyrics"
                            Click="LyricsToggle_Click">
                            <PathIcon Data="F1 M13 4C13 2.89543 12.1046 2 11 2C9.89543 2 9 2.89543 9 4C9 5.10457 9.89543 6 11 6C11.309 6 11.6015 5.92995 11.8628 5.80486C11.7521 6.47377 11.5779 7.05617 11.3527 7.58352C10.9446 8.53915 10.3576 9.34113 9.6255 10.1687C9.44254 10.3755 9.46188 10.6915 9.66871 10.8745C9.87554 11.0575 10.1915 11.0381 10.3745 10.8313C11.1424 9.96322 11.8054 9.06955 12.2723 7.97626C12.7404 6.88025 13 5.6107 13 4ZM18 8.78907V12.2764C18 13.6935 16.8359 14.8423 15.4 14.8423H10.81L6.79895 17.8034C6.35668 18.1298 5.73 18.0406 5.39921 17.6042C5.26989 17.4335 5.2 17.2262 5.2 17.0133L5.19937 14.8423H4.6C3.16406 14.8423 2 13.6935 2 12.2764V5.56582C2 4.14876 3.16406 3 4.6 3H8.17071C8.06015 3.31278 8 3.64936 8 4H4.6C3.70383 4 3 4.71348 3 5.56582V12.2764C3 13.1288 3.70383 13.8423 4.6 13.8423H6.19908L6.2 17L6.20346 16.9997L6.20502 16.9988L10.4809 13.8423H15.4C16.2962 13.8423 17 13.1288 17 12.2764V10.4204C17.3706 9.91978 17.7103 9.38326 18 8.78907ZM16 2C17.1046 2 18 2.89543 18 4C18 5.6107 17.7404 6.88025 17.2723 7.97626C16.8054 9.06955 16.1424 9.96322 15.3745 10.8313C15.1915 11.0381 14.8755 11.0575 14.6687 10.8745C14.4619 10.6915 14.4425 10.3755 14.6255 10.1687C15.3576 9.34113 15.9446 8.53915 16.3527 7.58352C16.5779 7.05617 16.7521 6.47377 16.8628 5.80486C16.6015 5.92995 16.309 6 16 6C14.8954 6 14 5.10457 14 4C14 2.89543 14.8954 2 16 2Z" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="QueueToggle"
                            Padding="8"
                            MinWidth="40"
                            MinHeight="40"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Playing Next"
                            Click="QueueToggle_Click">
                            <!-- Lencana ∞ menyala selama Autoplay aktif -->
                            <controls:QueueGlyph />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Frame x:Name="ContentFrame">
                    <!--
                        Pindah halaman dari sidebar: halaman baru masuk naik perlahan sambil memudar. Membuka album,
                        artis, atau playlist memakai "drill-in" (lihat Animations.DrillIn); Back memakai kebalikannya.
                    -->
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                    <EntranceNavigationTransitionInfo />
                                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>

                <!--
                    Tombol back di kiri atas halaman, seperti Apple Music; hanya muncul kalau ada halaman untuk kembali
                    (misalnya dari detail album ke Albums). Tombol back mouse dan Alt+← melakukan hal yang sama.
                -->
                <Button
                    x:Name="BackButton"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Margin="6,6,0,0"
                    CornerRadius="14"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#B3262626"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Back"
                    ToolTipService.ToolTip="Back (Alt+Left)"
                    Click="BackButton_Click">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>

                <!-- Panel Playing Next: lagu yang akan diputar berikutnya. Bisa digeser untuk mengubah urutan -->
                <Grid
                    x:Name="QueuePanel"
                    Grid.Column="1"
                    Width="340"
                    Visibility="Collapsed"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="1,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Padding="12,8,12,6" Spacing="4">
                        <SelectorBar x:Name="QueueTabs" SelectionChanged="QueueTabs_SelectionChanged">
                            <SelectorBarItem x:Name="UpNextTab" Text="Playing Next" IsSelected="True" />
                            <SelectorBarItem x:Name="HistoryTab" Text="History" />
                        </SelectorBar>
                        <Grid Padding="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="QueueCountText"
                                FontSize="12"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                VerticalAlignment="Center" />
                            <!-- Shuffle, Repeat, dan Autoplay, seperti Playing Next di Apple Music -->
                            <controls:QueueModeButtons x:Name="QueueModes" Grid.Column="1" VerticalAlignment="Center" />
                            <Button
                                x:Name="ClearQueueButton"
                                Grid.Column="2"
                                Content="Clear"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource AccentRedBrush}"
                                VerticalAlignment="Center"
                                Click="ClearQueue_Click" />
                        </Grid>
                    </StackPanel>

                    <ListView
                        x:Name="UpNextList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind Playback.UpNext}"
                        SelectionMode="Single"
                        CanDragItems="True"
                        CanReorderItems="True"
                        AllowDrop="True"
                        DoubleTapped="UpNextList_DoubleTapped"
                        RightTapped="UpNextList_RightTapped"
                        ContainerContentChanging="UpNextList_ContainerContentChanging">
                        <!-- Lagu masuk, keluar, dan berpindah dengan animasi; saat panel dibuka, isinya muncul berurutan -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                                <AddDeleteThemeTransition />
                                <ReorderThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueEntry">
                                <!-- Lagu Autoplay sedikit redup -->
                                <Grid ColumnSpacing="10" Opacity="{x:Bind ItemOpacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="40" Height="40" CornerRadius="4" Background="{StaticResource CoverPlaceholderBrush}">
                                        <Border CornerRadius="4">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock
                                            Text="{x:Bind Subtitle, Mode=OneWay}"
                                            FontSize="11"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind DurationText, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ListView
                        x:Name="HistoryList"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        SelectionMode="Single"
                        DoubleTapped="HistoryList_DoubleTapped"
                        RightTapped="HistoryList_RightTapped"
                        ContainerContentChanging="HistoryList_ContainerContentChanging">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryEntry">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="40" Height="40" CornerRadius="4" Background="{StaticResource CoverPlaceholderBrush}">
                                        <Border CornerRadius="4">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock
                                            Text="{x:Bind Subtitle}"
                                            FontSize="11"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind PlayedText}"
                                        FontSize="11"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="QueueEmptyText"
                        Grid.Row="1"
                        Margin="16,8,16,0"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>

                <!-- Panel lirik: di tempat yang sama dengan Playing Next, hanya salah satu yang terbuka -->
                <Border
                    x:Name="LyricsPanel"
                    Grid.Column="1"
                    Width="340"
                    Visibility="Collapsed"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="1,0,0,0">
                    <controls:LyricsView x:Name="LyricsPanelView" LineFontSize="22" ActiveLinePosition="0.3" />
                </Border>
            </Grid>
        </Grid>
    </NavigationView>
</Window>
