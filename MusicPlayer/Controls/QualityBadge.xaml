<?xml version="1.0" encoding="utf-8"?>
<!--
    Badge kualitas dan popup-nya: golongan dan detail format, mode output, lalu tombol ke pengaturan audio di
    Settings. Dipakai di LCD jendela utama, MiniPlayer, dan layar penuh.
    Ikon golongan kualitas adalah desain asli MusicPlayer (kanvas 20x20): Hi-Res = 7 batang rapat, Lossless = 5 batang
    utuh, Lossy = kolom titik yang terputus-putus. Geometry tidak bisa dipakai bersama, jadi path-nya ditulis per ikon. Popup boleh keluar dari batas jendela
    (ShouldConstrainToRootBounds), karena jendela MiniPlayer lebih kecil dari popup-nya.
-->
<UserControl
    x:Class="MusicPlayer.Controls.QualityBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.ViewModels"
    xmlns:helpers="using:MusicPlayer.Helpers">

    <Button
        Style="{StaticResource QualityBadgeButtonStyle}"
        Visibility="{x:Bind Playback.QualityVisibility, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="3">
            <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                <Grid Width="20" Height="20">
                    <PathIcon
                        Data="F1 M1,8.4 A0.9,0.9 0 0 1 2.8,8.4 V11.6 A0.9,0.9 0 0 1 1,11.6 Z M3.7,6.4 A0.9,0.9 0 0 1 5.5,6.4 V13.6 A0.9,0.9 0 0 1 3.7,13.6 Z M6.4,4.4 A0.9,0.9 0 0 1 8.2,4.4 V15.6 A0.9,0.9 0 0 1 6.4,15.6 Z M9.1,2.4 A0.9,0.9 0 0 1 10.9,2.4 V17.6 A0.9,0.9 0 0 1 9.1,17.6 Z M11.8,4.4 A0.9,0.9 0 0 1 13.6,4.4 V15.6 A0.9,0.9 0 0 1 11.8,15.6 Z M14.5,6.4 A0.9,0.9 0 0 1 16.3,6.4 V13.6 A0.9,0.9 0 0 1 14.5,13.6 Z M17.2,8.4 A0.9,0.9 0 0 1 19,8.4 V11.6 A0.9,0.9 0 0 1 17.2,11.6 Z"
                        Visibility="{x:Bind helpers:Formatters.VisibleIf(Playback.IsHiResQuality), Mode=OneWay}" />
                    <PathIcon
                        Data="F1 M0.9,8.3 A1.3,1.3 0 0 1 3.5,8.3 V11.7 A1.3,1.3 0 0 1 0.9,11.7 Z M4.8,5.8 A1.3,1.3 0 0 1 7.4,5.8 V14.2 A1.3,1.3 0 0 1 4.8,14.2 Z M8.7,3.3 A1.3,1.3 0 0 1 11.3,3.3 V16.7 A1.3,1.3 0 0 1 8.7,16.7 Z M12.6,5.8 A1.3,1.3 0 0 1 15.2,5.8 V14.2 A1.3,1.3 0 0 1 12.6,14.2 Z M16.5,8.3 A1.3,1.3 0 0 1 19.1,8.3 V11.7 A1.3,1.3 0 0 1 16.5,11.7 Z"
                        Visibility="{x:Bind helpers:Formatters.VisibleIf(Playback.IsLosslessQuality), Mode=OneWay}" />
                    <PathIcon
                        Data="F1 M0.9,8.2 A1.3,1.3 0 1 1 3.5,8.2 A1.3,1.3 0 1 1 0.9,8.2 Z M0.9,11.8 A1.3,1.3 0 1 1 3.5,11.8 A1.3,1.3 0 1 1 0.9,11.8 Z M4.8,6.4 A1.3,1.3 0 1 1 7.4,6.4 A1.3,1.3 0 1 1 4.8,6.4 Z M4.8,10 A1.3,1.3 0 1 1 7.4,10 A1.3,1.3 0 1 1 4.8,10 Z M4.8,13.6 A1.3,1.3 0 1 1 7.4,13.6 A1.3,1.3 0 1 1 4.8,13.6 Z M8.7,4.6 A1.3,1.3 0 1 1 11.3,4.6 A1.3,1.3 0 1 1 8.7,4.6 Z M8.7,8.2 A1.3,1.3 0 1 1 11.3,8.2 A1.3,1.3 0 1 1 8.7,8.2 Z M8.7,11.8 A1.3,1.3 0 1 1 11.3,11.8 A1.3,1.3 0 1 1 8.7,11.8 Z M8.7,15.4 A1.3,1.3 0 1 1 11.3,15.4 A1.3,1.3 0 1 1 8.7,15.4 Z M12.6,6.4 A1.3,1.3 0 1 1 15.2,6.4 A1.3,1.3 0 1 1 12.6,6.4 Z M12.6,10 A1.3,1.3 0 1 1 15.2,10 A1.3,1.3 0 1 1 12.6,10 Z M12.6,13.6 A1.3,1.3 0 1 1 15.2,13.6 A1.3,1.3 0 1 1 12.6,13.6 Z M16.5,8.2 A1.3,1.3 0 1 1 19.1,8.2 A1.3,1.3 0 1 1 16.5,8.2 Z M16.5,11.8 A1.3,1.3 0 1 1 19.1,11.8 A1.3,1.3 0 1 1 16.5,11.8 Z"
                        Visibility="{x:Bind helpers:Formatters.VisibleIf(Playback.IsLossyQuality), Mode=OneWay}" />
                </Grid>
            </Viewbox>
            <TextBlock Text="{x:Bind Playback.QualityShortText, Mode=OneWay}" VerticalAlignment="Center" />
        </StackPanel>
        <Button.Flyout>
            <Flyout x:Name="QualityFlyout" Placement="Bottom" ShouldConstrainToRootBounds="False">
                <StackPanel Width="300" Spacing="4">
                    <!-- Ikon besar golongan kualitas, seperti popup Apple Music -->
                    <Viewbox Width="44" Height="44" HorizontalAlignment="Center" Margin="0,4,0,4">
                        <Grid Width="20" Height="20">
                            <PathIcon
                                Data="F1 M1,8.4 A0.9,0.9 0 0 1 2.8,8.4 V11.6 A0.9,0.9 0 0 1 1,11.6 Z M3.7,6.4 A0.9,0.9 0 0 1 5.5,6.4 V13.6 A0.9,0.9 0 0 1 3.7,13.6 Z M6.4,4.4 A0.9,0.9 0 0 1 8.2,4.4 V15.6 A0.9,0.9 0 0 1 6.4,15.6 Z M9.1,2.4 A0.9,0.9 0 0 1 10.9,2.4 V17.6 A0.9,0.9 0 0 1 9.1,17.6 Z M11.8,4.4 A0.9,0.9 0 0 1 13.6,4.4 V15.6 A0.9,0.9 0 0 1 11.8,15.6 Z M14.5,6.4 A0.9,0.9 0 0 1 16.3,6.4 V13.6 A0.9,0.9 0 0 1 14.5,13.6 Z M17.2,8.4 A0.9,0.9 0 0 1 19,8.4 V11.6 A0.9,0.9 0 0 1 17.2,11.6 Z"
                                Visibility="{x:Bind helpers:Formatters.VisibleIf(Playback.IsHiResQuality), Mode=OneWay}" />
                            <PathIcon
                                Data="F1 M0.9,8.3 A1.3,1.3 0 0 1 3.5,8.3 V11.7 A1.3,1.3 0 0 1 0.9,11.7 Z M4.8,5.8 A1.3,1.3 0 0 1 7.4,5.8 V14.2 A1.3,1.3 0 0 1 4.8,14.2 Z M8.7,3.3 A1.3,1.3 0 0 1 11.3,3.3 V16.7 A1.3,1.3 0 0 1 8.7,16.7 Z M12.6,5.8 A1.3,1.3 0 0 1 15.2,5.8 V14.2 A1.3,1.3 0 0 1 12.6,14.2 Z M16.5,8.3 A1.3,1.3 0 0 1 19.1,8.3 V11.7 A1.3,1.3 0 0 1 16.5,11.7 Z"
                                Visibility="{x:Bind helpers:Formatters.VisibleIf(Playback.IsLosslessQuality), Mode=OneWay}" />
                            <PathIcon
                                Data="F1 M0.9,8.2 A1.3,1.3 0 1 1 3.5,8.2 A1.3,1.3 0 1 1 0.9,8.2 Z M0.9,11.8 A1.3,1.3 0 1 1 3.5,11.8 A1.3,1.3 0 1 1 0.9,11.8 Z M4.8,6.4 A1.3,1.3 0 1 1 7.4,6.4 A1.3,1.3 0 1 1 4.8,6.4 Z M4.8,10 A1.3,1.3 0 1 1 7.4,10 A1.3,1.3 0 1 1 4.8,10 Z M4.8,13.6 A1.3,1.3 0 1 1 7.4,13.6 A1.3,1.3 0 1 1 4.8,13.6 Z M8.7,4.6 A1.3,1.3 0 1 1 11.3,4.6 A1.3,1.3 0 1 1 8.7,4.6 Z M8.7,8.2 A1.3,1.3 0 1 1 11.3,8.2 A1.3,1.3 0 1 1 8.7,8.2 Z M8.7,11.8 A1.3,1.3 0 1 1 11.3,11.8 A1.3,1.3 0 1 1 8.7,11.8 Z M8.7,15.4 A1.3,1.3 0 1 1 11.3,15.4 A1.3,1.3 0 1 1 8.7,15.4 Z M12.6,6.4 A1.3,1.3 0 1 1 15.2,6.4 A1.3,1.3 0 1 1 12.6,6.4 Z M12.6,10 A1.3,1.3 0 1 1 15.2,10 A1.3,1.3 0 1 1 12.6,10 Z M12.6,13.6 A1.3,1.3 0 1 1 15.2,13.6 A1.3,1.3 0 1 1 12.6,13.6 Z M16.5,8.2 A1.3,1.3 0 1 1 19.1,8.2 A1.3,1.3 0 1 1 16.5,8.2 Z M16.5,11.8 A1.3,1.3 0 1 1 19.1,11.8 A1.3,1.3 0 1 1 16.5,11.8 Z"
                                Visibility="{x:Bind helpers:Formatters.VisibleIf(Playback.IsLossyQuality), Mode=OneWay}" />
                        </Grid>
                    </Viewbox>
                    <TextBlock
                        Text="{x:Bind Playback.QualityBadgeText, Mode=OneWay}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind Playback.QualityDetailText, Mode=OneWay}"
                        HorizontalAlignment="Center" />

                    <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,8" />

                    <TextBlock
                        Text="{x:Bind Playback.OutputModeText, Mode=OneWay}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AccentRedBrush}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind Playback.OutputDetailText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind Playback.DeviceText, Mode=OneWay}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Center" />


                    <!-- Pilihan output dan exclusive mode ada di Settings; popup ini hanya menampilkan keadaannya -->
                    <Button
                        Content="Audio Quality Settings"
                        HorizontalAlignment="Stretch"
                        Margin="0,10,0,0"
                        Click="AudioSettings_Click" />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
