<?xml version="1.0" encoding="utf-8"?>
<!--
    Tombol sleep timer (bulan) di kanan atas. Menyala merah selama timer aktif, dengan sisa waktunya di samping ikon
    untuk timer berdasarkan waktu. Menunya: matikan, sekian menit, atau setelah lagu/album ini.
-->
<UserControl
    x:Class="MusicPlayer.Controls.SleepTimerButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button
        x:Name="TimerButton"
        Padding="8"
        MinWidth="40"
        MinHeight="40"
        Background="Transparent"
        BorderThickness="0"
        AutomationProperties.Name="Sleep Timer"
        ToolTipService.ToolTip="Sleep Timer">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon x:Name="MoonIcon" Glyph="&#xE708;" FontSize="16" />
            <TextBlock
                x:Name="RemainingText"
                FontSize="12"
                VerticalAlignment="Center"
                Foreground="{StaticResource AccentRedBrush}"
                Visibility="Collapsed" />
        </StackPanel>
        <Button.Flyout>
            <MenuFlyout x:Name="TimerMenu" Placement="Bottom" Opening="TimerMenu_Opening">
                <MenuFlyoutItem x:Name="StatusItem" IsEnabled="False" />
                <MenuFlyoutSeparator x:Name="StatusSeparator" />
                <RadioMenuFlyoutItem x:Name="OffItem" Text="Off" GroupName="Sleep" Click="Off_Click" />
                <RadioMenuFlyoutItem Text="15 minutes" Tag="15" GroupName="Sleep" Click="Minutes_Click" />
                <RadioMenuFlyoutItem Text="30 minutes" Tag="30" GroupName="Sleep" Click="Minutes_Click" />
                <RadioMenuFlyoutItem Text="45 minutes" Tag="45" GroupName="Sleep" Click="Minutes_Click" />
                <RadioMenuFlyoutItem Text="1 hour" Tag="60" GroupName="Sleep" Click="Minutes_Click" />
                <RadioMenuFlyoutItem Text="2 hours" Tag="120" GroupName="Sleep" Click="Minutes_Click" />
                <MenuFlyoutSeparator />
                <RadioMenuFlyoutItem x:Name="SongItem" Text="When this song ends" GroupName="Sleep" Click="Song_Click" />
                <RadioMenuFlyoutItem x:Name="AlbumItem" Text="When this album ends" GroupName="Sleep" Click="Album_Click" />
            </MenuFlyout>
        </Button.Flyout>
    </Button>
</UserControl>
