<?xml version="1.0" encoding="utf-8"?>
<!--
    Halaman playlist seperti Apple Music (screenshot 9): kotak cover, nama, jumlah lagu dan durasi, tombol Play dan
    Shuffle, lalu daftar lagu dengan cover kecil. Dipakai untuk Favourite Songs dan playlist buatan sendiri; urutan
    playlist buatan sendiri bisa diubah dengan menyeret barisnya (diaktifkan dari kode).
-->
<Page
    x:Class="MusicPlayer.Pages.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.ViewModels">

    <Page.Resources>
        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>
    </Page.Resources>

    <!-- Kepala halaman ikut ter-scroll bersama daftar lagu, sama seperti halaman album -->
    <ListView
        x:Name="TrackList"
        Padding="32,0,32,0"
        SelectionMode="Single"
        DoubleTapped="TrackList_DoubleTapped"
        RightTapped="TrackList_RightTapped"
        ContainerContentChanging="TrackList_ContainerContentChanging"
        DragItemsCompleted="TrackList_DragItemsCompleted">

        <ListView.Header>
            <StackPanel>
                <Grid ColumnSpacing="32" Margin="0,32,0,24" Height="220">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cover: bintang (Favourite Songs), satu cover (1–3 album), atau mozaik 2×2 (4 album atau lebih) -->
                    <Grid CornerRadius="8" Background="{StaticResource CoverPlaceholderBrush}">
                        <FontIcon Glyph="&#xE8D6;" FontSize="64" Foreground="{StaticResource SecondaryTextBrush}" />
                        <Grid x:Name="FavouritesTile" Background="#FFEFEFEF" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE735;" FontSize="96" Foreground="{StaticResource AccentRedBrush}" />
                        </Grid>
                        <Border x:Name="SingleCover" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="SingleCoverBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Grid x:Name="MosaicCover" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border>
                                <Border.Background>
                                    <ImageBrush x:Name="Mosaic1" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border Grid.Column="1">
                                <Border.Background>
                                    <ImageBrush x:Name="Mosaic2" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border Grid.Row="1">
                                <Border.Background>
                                    <ImageBrush x:Name="Mosaic3" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1">
                                <Border.Background>
                                    <ImageBrush x:Name="Mosaic4" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="TitleText"
                            Grid.Row="1"
                            FontSize="28"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis" />
                        <!-- Contoh: "12 songs · 47 minutes" -->
                        <TextBlock
                            x:Name="MetaText"
                            Grid.Row="2"
                            Margin="0,6,0,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}" />

                        <!-- Menu satu playlist: Play Next, Add to Queue, lalu Rename dan Delete untuk playlist buatan sendiri -->
                        <Button
                            x:Name="PlaylistMoreButton"
                            Grid.Row="4"
                            Padding="8,4"
                            MinWidth="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="More"
                            Click="PlaylistMore_Click">
                            <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{StaticResource AccentRedBrush}" />
                        </Button>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Padding="20,6" Click="Play_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ShuffleButton" Style="{StaticResource AccentButtonStyle}" Padding="20,6" Click="Shuffle_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Shuffle" />
                                    <TextBlock Text="Shuffle" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Judul kolom. Lebar kolomnya harus sama dengan template baris di bawah -->
                <Grid x:Name="ColumnHeaders" ColumnSpacing="12" Padding="12,0,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" Text="Song" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock Grid.Column="3" Text="Artist" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock Grid.Column="4" Text="Album" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock Grid.Column="5" Text="Time" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </ListView.Header>

        <ListView.ItemContainerStyle>
            <!-- Isi baris dibuat memenuhi seluruh kotaknya, supaya latar belangnya menutup satu baris penuh -->
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </ListView.ItemContainerStyle>

        <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:TrackRow">
                <Grid
                    ColumnSpacing="12"
                    Padding="12,0"
                    CornerRadius="4"
                    Background="{x:Bind RowBackground, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <!-- Bintang merah untuk lagu favorit -->
                    <FontIcon
                        Glyph="&#xE735;"
                        FontSize="10"
                        Foreground="{StaticResource AccentRedBrush}"
                        Visibility="{x:Bind FavouriteVisibility, Mode=OneWay}"
                        VerticalAlignment="Center" />

                    <!-- Cover kecil; lagu yang sedang diputar ditandai ikon play di atasnya -->
                    <Grid
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        Background="{StaticResource CoverPlaceholderBrush}">
                        <Border CornerRadius="4">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Grid CornerRadius="4" Background="#99000000" Visibility="{x:Bind PlayingVisibility, Mode=OneWay}">
                            <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="White" />
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Column="2" Text="{x:Bind Title}" Style="{StaticResource CellStyle}" />
                    <TextBlock
                        Grid.Column="3"
                        Text="{x:Bind ArtistText}"
                        Style="{StaticResource CellStyle}"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock
                        Grid.Column="4"
                        Text="{x:Bind AlbumText}"
                        Style="{StaticResource CellStyle}"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock
                        Grid.Column="5"
                        Text="{x:Bind DurationText}"
                        Style="{StaticResource CellStyle}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Right" />
                    <!-- Menu yang sama dengan klik kanan, seperti tombol ••• di Apple Music -->
                    <Button
                        Grid.Column="6"
                        Padding="6,2"
                        MinWidth="0"
                        MinHeight="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        ToolTipService.ToolTip="More"
                        Click="RowMore_Click">
                        <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{StaticResource AccentRedBrush}" />
                    </Button>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>

        <ListView.Footer>
            <StackPanel x:Name="EmptyState" Margin="12,24,0,40" Spacing="6" Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="EmptyDetail" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </ListView.Footer>
    </ListView>
</Page>
