<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MusicPlayer.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicPlayer.Controls">

    <Page.Resources>
        <!-- Judul tiap bagian, di atas kartunya -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,28,0,8" />
        </Style>

        <!-- Kartu pengaturan ala Windows 11: padding vertikal diatur per baris supaya garis pemisah rapat -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF262626" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <Style x:Key="RowSeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>

        <Style x:Key="SettingsRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="0,12" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>

        <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Catatan kecil di bawah kartu -->
        <Style x:Key="FootnoteTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Margin" Value="4,8,0,0" />
        </Style>

        <!-- Tombol keyboard di daftar pintasan -->
        <Style x:Key="KeyChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinWidth" Value="28" />
        </Style>

        <Style x:Key="KeyChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ChipListStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OrTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <!-- Kolom ber-MaxWidth di Grid: lebar penuh sampai 900, tetap rata kiri (StackPanel rata kiri akan mengecil ke isinya) -->
        <Grid Padding="24,20,24,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="900" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

                <!-- 1. Library -->
                <TextBlock Text="Library" Style="{StaticResource SectionHeaderStyle}" Margin="0,20,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Padding="0,12" Spacing="2">
                            <TextBlock Text="Music folders" />
                            <TextBlock
                                Text="Songs in these folders, including all subfolders, appear in your library."
                                Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <ItemsControl x:Name="FolderList">
                            <ItemsControl.ItemTemplate>
                                <!-- Item-nya berupa string (path folder), jadi cukup {Binding} biasa -->
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{StaticResource RowSeparatorStyle}" />
                                        <Grid Style="{StaticResource SettingsRowStyle}" Padding="0,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                Glyph="&#xE8B7;"
                                                FontSize="16"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding}"
                                                ToolTipService.ToolTip="{Binding}"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Content="Remove" Tag="{Binding}" Click="RemoveFolder_Click" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel x:Name="NoFoldersPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource RowSeparatorStyle}" />
                            <TextBlock
                                Text="No folders yet. Add a folder to start your library."
                                Margin="0,12"
                                Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <Border Style="{StaticResource RowSeparatorStyle}" />
                        <StackPanel Padding="0,12" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="AddFolderButton"
                                    Content="Add folder"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="AddFolder_Click" />
                                <Button x:Name="ScanButton" Content="Rescan library" Click="Scan_Click" />
                            </StackPanel>

                            <ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" Visibility="Collapsed" />
                            <!-- Disembunyikan selama kosong (diatur dari kode) supaya kartu tidak punya baris kosong -->
                            <TextBlock
                                x:Name="StatusText"
                                Visibility="Collapsed"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Playback & Audio: panel menggambar baris-barisnya sendiri, kartunya dari sini -->
                <TextBlock x:Name="AudioHeader" Text="Playback &amp; Audio" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <controls:AudioSettingsPanel />
                </Border>

                <!-- 3. Lyrics -->
                <TextBlock Text="Lyrics" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Show reading (romanization)" TextWrapping="Wrap" />
                                <TextBlock
                                    Text="Romaji, pinyin, or another reading under each line."
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="ShowReadingToggle"
                                Grid.Column="1"
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                AutomationProperties.Name="Show reading (romanization)"
                                Toggled="ShowReadingToggle_Toggled" />
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}" />
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Show translation" TextWrapping="Wrap" />
                                <TextBlock
                                    Text="The translation in smaller text under each line."
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="ShowTranslationToggle"
                                Grid.Column="1"
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                AutomationProperties.Name="Show translation"
                                Toggled="ShowTranslationToggle_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock
                    Text="Applies to songs whose lyrics include a reading or translation, written in the lyrics editor or in a three-line .lrc file."
                    Style="{StaticResource FootnoteTextStyle}" />

                <!-- 4. Keyboard & mouse: hanya daftar baca, harus sama dengan PlaybackShortcuts -->
                <TextBlock Text="Keyboard &amp; mouse" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <TextBlock Text="Play / pause" VerticalAlignment="Center" />
                            <StackPanel Style="{StaticResource ChipListStyle}">
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="Space" Style="{StaticResource KeyChipTextStyle}" /></Border>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}" />
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <TextBlock Text="Next song" VerticalAlignment="Center" />
                            <StackPanel Style="{StaticResource ChipListStyle}">
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="Ctrl" Style="{StaticResource KeyChipTextStyle}" /></Border>
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="&#x2192;" Style="{StaticResource KeyChipTextStyle}" /></Border>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}" />
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <TextBlock Text="Previous song" VerticalAlignment="Center" />
                            <StackPanel Style="{StaticResource ChipListStyle}">
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="Ctrl" Style="{StaticResource KeyChipTextStyle}" /></Border>
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="&#x2190;" Style="{StaticResource KeyChipTextStyle}" /></Border>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}" />
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <TextBlock Text="Volume up" VerticalAlignment="Center" />
                            <StackPanel Style="{StaticResource ChipListStyle}">
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="Ctrl" Style="{StaticResource KeyChipTextStyle}" /></Border>
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="&#x2191;" Style="{StaticResource KeyChipTextStyle}" /></Border>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}" />
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <TextBlock Text="Volume down" VerticalAlignment="Center" />
                            <StackPanel Style="{StaticResource ChipListStyle}">
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="Ctrl" Style="{StaticResource KeyChipTextStyle}" /></Border>
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="&#x2193;" Style="{StaticResource KeyChipTextStyle}" /></Border>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}" />
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <TextBlock Text="Search" VerticalAlignment="Center" />
                            <StackPanel Style="{StaticResource ChipListStyle}">
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="Ctrl" Style="{StaticResource KeyChipTextStyle}" /></Border>
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="F" Style="{StaticResource KeyChipTextStyle}" /></Border>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}" />
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <TextBlock Text="Go back" VerticalAlignment="Center" />
                            <StackPanel Style="{StaticResource ChipListStyle}">
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="Alt" Style="{StaticResource KeyChipTextStyle}" /></Border>
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="&#x2190;" Style="{StaticResource KeyChipTextStyle}" /></Border>
                                <TextBlock Text="or" Style="{StaticResource OrTextStyle}" />
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="Mouse Back button" Style="{StaticResource KeyChipTextStyle}" /></Border>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}" />
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <TextBlock Text="Go forward" VerticalAlignment="Center" />
                            <StackPanel Style="{StaticResource ChipListStyle}">
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="Alt" Style="{StaticResource KeyChipTextStyle}" /></Border>
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="&#x2192;" Style="{StaticResource KeyChipTextStyle}" /></Border>
                                <TextBlock Text="or" Style="{StaticResource OrTextStyle}" />
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="Mouse Forward button" Style="{StaticResource KeyChipTextStyle}" /></Border>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowSeparatorStyle}" />
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <TextBlock Text="Exit full screen" VerticalAlignment="Center" />
                            <StackPanel Style="{StaticResource ChipListStyle}">
                                <Border Style="{StaticResource KeyChipStyle}"><TextBlock Text="Esc" Style="{StaticResource KeyChipTextStyle}" /></Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock
                    Text="Playback and search shortcuts don't apply while you're typing in a text box."
                    Style="{StaticResource FootnoteTextStyle}" />

                <!-- 5. About -->
                <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Padding="0,12" Spacing="2">
                            <TextBlock Text="MusicPlayer" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextStyle}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <Border Style="{StaticResource RowSeparatorStyle}" />
                        <StackPanel Padding="0,12" Spacing="2">
                            <TextBlock Text="Database" />
                            <TextBlock
                                x:Name="DatabasePathText"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
