<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MusicPlayer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Warna aksen seluruh aplikasi diganti dari biru bawaan Windows ke merah ala Apple Music.
                Di tema gelap, kontrol memakai varian "Light2" sebagai warna aksen utamanya.
            -->
            <Color x:Key="SystemAccentColorDark3">#FF7A0E1F</Color>
            <Color x:Key="SystemAccentColorDark2">#FF9C1427</Color>
            <Color x:Key="SystemAccentColorDark1">#FFC21B33</Color>
            <Color x:Key="SystemAccentColor">#FFE0233D</Color>
            <Color x:Key="SystemAccentColorLight1">#FFEF2943</Color>
            <Color x:Key="SystemAccentColorLight2">#FFFA2D48</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFC5A6F</Color>

            <!-- Palet warna ala Apple Music -->
            <SolidColorBrush x:Key="AccentRedBrush" Color="#FFFA2D48" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FF242424" />
            <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FF1E1E1E" />
            <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="LcdBackgroundBrush" Color="#FF3A3A3A" />
            <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#FF4A4A4A" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#99FFFFFF" />

            <!--
                Tulisan dan ikon di tombol merah (Play, Shuffle, Save, Check Library) putih seperti Apple Music. Bawaan
                tema gelap WinUI memakai warna hitam di atas warna aksen.
            -->
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#66FFFFFF" />

            <!-- Tombol ikon merah tanpa latar (Play, Shuffle, ••• di halaman Artists), seperti Apple Music -->
            <Style x:Key="RedIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
            </Style>

            <!--
                Tombol tanpa tampilan sendiri, untuk kotak yang bisa diklik (cover di rak, Latest Release): yang tampil
                hanya isinya. Lebih andal daripada Tapped, dan bisa dipakai dengan keyboard.
            -->
            <Style x:Key="TileButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Banner halaman artis: tombol Play merah bulat di samping nama, seperti Apple Music -->
            <Style x:Key="BannerPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="22" />
            </Style>

            <!-- Banner halaman artis: tombol bulat gelap transparan (Shuffle, •••) di kanan bawah -->
            <Style x:Key="BannerCircleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Background" Value="#66000000" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- Panah bulat untuk menggulir rak mendatar (More by), seperti Apple Music -->
            <Style x:Key="ShelfArrowButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Background" Value="#E62B2B2B" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- Tombol transport (prev/play/next) tanpa latar dan bingkai -->
            <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
            </Style>

            <!-- Badge kualitas kecil (ikon dan teks, tanpa kotak seperti Apple Music): "Hi-Res", "Lossless", atau codec lossy -->
            <Style x:Key="QualityBadgeButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#66FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Padding" Value="1,0,3,1" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
