<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MusicPlayer.Pages.ArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.ViewModels"
    xmlns:controls="using:MusicPlayer.Controls"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
    </Page.Resources>

    <!-- Dua kolom seperti Apple Music: daftar artis di kiri, detail artis yang dipilih di kanan, judul di atasnya -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:PageHeader Grid.ColumnSpan="2" Title="Artists" />
        <ListView
            x:Name="ArtistList"
            Grid.Row="1"
            Padding="8,12,8,12"
            BorderThickness="0,0,1,0"
            BorderBrush="#1FFFFFFF"
            SelectionMode="Single"
            SelectionChanged="ArtistList_SelectionChanged"
            ContainerContentChanging="ArtistList_ContainerContentChanging">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ArtistItem">
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                        <!-- Foto bulat: placeholder abu-abu, tertutup cover saat sudah dimuat -->
                        <Grid Width="40" Height="40">
                            <Ellipse Fill="{StaticResource CoverPlaceholderBrush}" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <TextBlock
                            Text="{x:Bind Name}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="180" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer x:Name="DetailScroller" Grid.Row="1" Grid.Column="1">
            <StackPanel Padding="40,28,32,40">
                <!--
                    Seperti Apple Music: nama artis (membuka halaman artisnya) di kiri, ikon Play, Shuffle, dan ••• merah
                    di kanan, jumlah album dan lagu di bawah nama.
                -->
                <Grid Margin="0,0,0,28">
                    <StackPanel>
                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            ToolTipService.ToolTip="Go to Artist"
                            Click="ArtistName_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="ArtistNameText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <FontIcon Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ArtistCountText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource RedIconButtonStyle}" ToolTipService.ToolTip="Play" Click="Play_Click">
                            <Viewbox Width="16" Height="16">
                                <PathIcon Data="F1 M17.2221 8.68458C18.2586 9.25438 18.2586 10.7437 17.2221 11.3135L7.22259 16.8105C6.22292 17.36 5 16.6367 5 15.496L5 4.50214C5 3.36137 6.22292 2.63812 7.22259 3.18766L17.2221 8.68458Z" Foreground="{StaticResource AccentRedBrush}" />
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource RedIconButtonStyle}" ToolTipService.ToolTip="Shuffle" Click="Shuffle_Click">
                            <Viewbox Width="18" Height="18">
                                <PathIcon Data="F1 M15.7803 3.71967C15.4874 3.42678 15.0126 3.42678 14.7197 3.71967C14.4268 4.01256 14.4268 4.48744 14.7197 4.78033L15.4735 5.53419C12.3828 5.81153 10.5945 7.72788 8.99886 9.43788L8.9517 9.48841C7.18821 11.3779 5.6408 13.0002 2.75 13.0002C2.33579 13.0002 2 13.336 2 13.7502C2 14.1645 2.33579 14.5002 2.75 14.5002C6.32656 14.5002 8.27635 12.4108 10.0011 10.5624L10.0483 10.5119C11.628 8.81932 13.0343 7.34116 15.388 7.05139L14.7197 7.71975C14.4268 8.01265 14.4268 8.48752 14.7197 8.78041C15.0126 9.07331 15.4874 9.07331 15.7803 8.78041L17.7804 6.78037C18.0733 6.48748 18.0733 6.0126 17.7804 5.71971L15.7803 3.71967ZM2.75 5.50024C5.52864 5.50024 7.32539 6.76133 8.79759 8.19071C8.63182 8.36517 8.47131 8.53728 8.31508 8.70481L8.22064 8.80606C8.06689 8.97079 7.9169 9.13088 7.76961 9.2859C6.41908 7.97133 4.98663 7.00024 2.75 7.00024C2.33579 7.00024 2 6.66446 2 6.25024C2 5.83603 2.33579 5.50024 2.75 5.50024ZM15.4735 14.4658C13.1281 14.2554 11.5327 13.1011 10.2024 11.8095C10.3682 11.635 10.5288 11.4628 10.685 11.2953L10.7794 11.1941C10.9331 11.0294 11.0831 10.8693 11.2304 10.7143C12.399 11.8518 13.6289 12.7321 15.388 12.9486L14.7197 12.2802C14.4268 11.9874 14.4268 11.5125 14.7197 11.2196C15.0126 10.9267 15.4874 10.9267 15.7803 11.2196L17.7804 13.2196C18.0733 13.5125 18.0733 13.9874 17.7804 14.2803L15.7803 16.2803C15.4874 16.5732 15.0126 16.5732 14.7197 16.2803C14.4268 15.9874 14.4268 15.5126 14.7197 15.2197L15.4735 14.4658Z" Foreground="{StaticResource AccentRedBrush}" />
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource RedIconButtonStyle}" ToolTipService.ToolTip="More" Click="ArtistMore_Click">
                            <FontIcon Glyph="&#xE712;" FontSize="16" Foreground="{StaticResource AccentRedBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Setiap album: cover di kiri, daftar lagu di kanan. Klik dua kali sebuah lagu untuk memutarnya -->
                <ItemsRepeater
                    x:Name="AlbumRepeater"
                    DoubleTapped="AlbumRepeater_DoubleTapped"
                    RightTapped="AlbumRepeater_RightTapped">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:AlbumBlock">
                            <Grid ColumnSpacing="28" Margin="0,0,0,40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Cover bisa diklik untuk membuka halaman albumnya; jumlah lagu dan durasi di bawahnya -->
                                <StackPanel VerticalAlignment="Top" Spacing="8">
                                <Grid
                                    Width="200"
                                    Height="200"
                                    CornerRadius="6"
                                    Background="{StaticResource CoverPlaceholderBrush}"
                                    Tapped="AlbumCover_Tapped"
                                    PointerEntered="Tile_PointerEntered"
                                    PointerExited="Tile_PointerExited">
                                    <FontIcon Glyph="&#xE93C;" FontSize="40" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <Border CornerRadius="6">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind SummaryText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Margin="0,0,48,0">
                                            <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{x:Bind Meta}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                Margin="0,2,0,0" />
                                        </StackPanel>
                                        <!-- Menu album: Play Next, Add to Queue, playlist, info -->
                                        <Button
                                            Style="{StaticResource RedIconButtonStyle}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            ToolTipService.ToolTip="More"
                                            Click="AlbumMore_Click">
                                            <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{StaticResource AccentRedBrush}" />
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{x:Bind Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TrackRow">
                                                <Grid
                                                    Height="44"
                                                    ColumnSpacing="16"
                                                    Padding="12,0,4,0"
                                                    CornerRadius="4"
                                                    Background="{x:Bind RowBackground}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="32" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Bintang merah untuk lagu favorit, di kiri nomor track seperti Apple Music -->
                                                    <FontIcon
                                                        Glyph="&#xE735;"
                                                        FontSize="10"
                                                        Foreground="{StaticResource AccentRedBrush}"
                                                        Visibility="{x:Bind FavouriteVisibility, Mode=OneWay}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        Text="{x:Bind NumberText}"
                                                        Visibility="{x:Bind NumberVisibility, Mode=OneWay}"
                                                        Style="{StaticResource CellStyle}"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        HorizontalAlignment="Right" />
                                                    <FontIcon
                                                        Glyph="&#xE768;"
                                                        FontSize="12"
                                                        Foreground="{StaticResource AccentRedBrush}"
                                                        Visibility="{x:Bind PlayingVisibility, Mode=OneWay}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource CellStyle}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{x:Bind DurationText}"
                                                        Style="{StaticResource CellStyle}"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        HorizontalAlignment="Right" />
                                                    <!-- Menu yang sama dengan klik kanan -->
                                                    <Button
                                                        Grid.Column="3"
                                                        Padding="6,2"
                                                        MinWidth="0"
                                                        MinHeight="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="More"
                                                        Click="RowMore_Click">
                                                        <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{StaticResource AccentRedBrush}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            x:Name="EmptyState"
            Grid.ColumnSpan="2"
            Visibility="Collapsed"
            Spacing="8"
            Margin="0,48,0,0"
            HorizontalAlignment="Center">
            <TextBlock Text="No artists yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="Add a music folder in Settings (the gear icon at the bottom left)."
                Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</Page>
