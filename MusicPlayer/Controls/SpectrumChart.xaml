<?xml version="1.0" encoding="utf-8"?>
<!--
    Grafik spektrum rata-rata hasil pemeriksaan kualitas sumber: frekuensi mendatar (0 sampai batas format), level
    tegak. Garis merah: tempat suara berhenti. Garis putus-putus (file hi-res): batas CD 22,05 kHz. Dipakai di popup
    badge kualitas dan halaman Quality Check.
-->
<UserControl
    x:Class="MusicPlayer.Controls.SpectrumChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="4">
        <Grid x:Name="ChartArea" Height="80" CornerRadius="4" Background="#14FFFFFF" HorizontalAlignment="Left">
            <Canvas x:Name="ChartCanvas" Width="300" Height="80">
                <Line
                    x:Name="CdLimitLine"
                    Stroke="#55FFFFFF"
                    StrokeThickness="1"
                    StrokeDashArray="2,2"
                    Visibility="Collapsed" />
                <Line
                    x:Name="CutoffLine"
                    Stroke="{StaticResource AccentRedBrush}"
                    StrokeThickness="1"
                    Visibility="Collapsed" />
                <Polyline x:Name="SpectrumLine" Stroke="#DDFFFFFF" StrokeThickness="1.2" />
            </Canvas>
        </Grid>
        <Grid x:Name="LabelRow" Width="300" HorizontalAlignment="Left">
            <TextBlock Text="0 kHz" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock
                x:Name="LegendText"
                FontSize="11"
                HorizontalAlignment="Center"
                Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock
                x:Name="MaxText"
                FontSize="11"
                HorizontalAlignment="Right"
                Foreground="{StaticResource SecondaryTextBrush}" />
        </Grid>
    </StackPanel>
</UserControl>
