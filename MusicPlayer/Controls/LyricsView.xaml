<?xml version="1.0" encoding="utf-8"?>
<!--
    Lirik lagu yang sedang diputar, seperti Apple Music: baris yang sedang dinyanyikan menyala dan bergulir ke posisinya,
    baris lain redup. Klik baris untuk lompat ke bagian itu. Dipakai di panel kanan jendela utama dan di layar penuh.
    Baris-barisnya dibuat dari kode (LyricsView.xaml.cs), karena kecerahan dan posisi gulirnya diatur per baris.
-->
<UserControl
    x:Class="MusicPlayer.Controls.LyricsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <ScrollViewer
            x:Name="Scroller"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            SizeChanged="Scroller_SizeChanged">
            <StackPanel x:Name="LinesPanel" Margin="8,0" />
        </ScrollViewer>

        <ProgressRing
            x:Name="LoadingRing"
            Width="32"
            Height="32"
            IsActive="False"
            Visibility="Collapsed" />

        <!-- Saat tidak ada lirik: apa yang terjadi dan apa yang bisa dilakukan -->
        <StackPanel
            x:Name="MessagePanel"
            Spacing="6"
            Margin="24,0"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock
                x:Name="MessageTitle"
                FontSize="15"
                FontWeight="SemiBold"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="MessageDetail"
                FontSize="13"
                Foreground="{StaticResource SecondaryTextBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="RetryButton"
                Content="Try Again"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Visibility="Collapsed"
                Click="RetryButton_Click" />
            <!-- Lagu tanpa lirik: tulis atau tempel liriknya sendiri di editor lirik -->
            <Button
                x:Name="AddLyricsButton"
                Content="Add Lyrics…"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Visibility="Collapsed"
                Click="EditButton_Click" />
        </StackPanel>

        <!--
            Cara baca dan terjemahan (ditulis di editor lirik) bisa disembunyikan; tombolnya hanya muncul kalau lagu ini
            punya lapisan itu. Tombol pensil membuka editor lirik.
        -->
        <StackPanel
            x:Name="Toolbar"
            Orientation="Horizontal"
            Spacing="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,0,8,0"
            Visibility="Collapsed">
            <ToggleButton
                x:Name="ReadingToggle"
                Content="Reading"
                FontSize="12"
                Padding="10,3"
                MinHeight="0"
                ToolTipService.ToolTip="Show how each line is read"
                Click="ReadingToggle_Click" />
            <ToggleButton
                x:Name="TranslationToggle"
                Content="Translation"
                FontSize="12"
                Padding="10,3"
                MinHeight="0"
                ToolTipService.ToolTip="Show the translation"
                Click="TranslationToggle_Click" />
            <Button
                Padding="7,5"
                MinWidth="0"
                MinHeight="0"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Edit lyrics, reading, and translation"
                Click="EditButton_Click">
                <FontIcon Glyph="&#xE70F;" FontSize="13" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
