<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MusicPlayer.Pages.FolderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MusicPlayer.ViewModels">

    <Page.Resources>
        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
    </Page.Resources>

    <!-- Kepala halaman (jalur, subfolder) ikut ter-scroll bersama daftar lagu -->
    <ListView
        x:Name="TrackList"
        Padding="32,0,32,0"
        SelectionMode="Single"
        DoubleTapped="TrackList_DoubleTapped"
        RightTapped="TrackList_RightTapped">

        <ListView.Header>
            <StackPanel Margin="0,24,0,8" Spacing="6">
                <!-- Jalur folder; klik salah satu bagiannya untuk kembali ke folder itu -->
                <BreadcrumbBar x:Name="PathBar" ItemClicked="PathBar_ItemClicked" />

                <TextBlock x:Name="FolderNameText" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock x:Name="FolderCountText" Foreground="{StaticResource SecondaryTextBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,16">
                    <Button Style="{StaticResource AccentButtonStyle}" Padding="20,6" Click="Play_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Play" />
                            <TextBlock Text="Play" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Padding="20,6" Click="Shuffle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Shuffle" />
                            <TextBlock Text="Shuffle" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <GridView
                    x:Name="SubfolderGrid"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="SubfolderGrid_ItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderItem">
                            <StackPanel Width="150" Margin="0,0,0,8">
                                <Grid
                                    Width="150"
                                    Height="150"
                                    CornerRadius="6"
                                    Background="{StaticResource CoverPlaceholderBrush}">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <Border CornerRadius="6">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="130" />
                                </StackPanel>
                                <TextBlock
                                    Text="{x:Bind CountText}"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock
                    x:Name="SongsHeader"
                    Text="Songs in this folder"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,16,0,4" />
            </StackPanel>
        </ListView.Header>

        <!-- Isi baris memenuhi kotaknya, supaya latar belang menutup satu baris penuh -->
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </ListView.ItemContainerStyle>

        <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:TrackRow">
                <Grid
                    ColumnSpacing="16"
                    Padding="12,0"
                    CornerRadius="4"
                    Background="{x:Bind RowBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <!-- Bintang merah untuk lagu favorit, di kiri nomor track seperti Apple Music -->
                    <FontIcon
                        Glyph="&#xE735;"
                        FontSize="10"
                        Foreground="{StaticResource AccentRedBrush}"
                        Visibility="{x:Bind FavouriteVisibility, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind NumberText}"
                        Visibility="{x:Bind NumberVisibility, Mode=OneWay}"
                        Style="{StaticResource CellStyle}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Right" />
                    <FontIcon
                        Glyph="&#xE768;"
                        FontSize="12"
                        Foreground="{StaticResource AccentRedBrush}"
                        Visibility="{x:Bind PlayingVisibility, Mode=OneWay}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource CellStyle}" />
                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind ArtistText}"
                        Style="{StaticResource CellStyle}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        MaxWidth="420" />
                    <TextBlock
                        Grid.Column="3"
                        Text="{x:Bind DurationText}"
                        Style="{StaticResource CellStyle}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Right" />
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</Page>
