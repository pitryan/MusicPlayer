<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MusicPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicPlayer.Controls"
    xmlns:vm="using:MusicPlayer.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MusicPlayer">

    <NavigationView
        x:Name="NavView"
        PaneDisplayMode="Left"
        OpenPaneLength="260"
        IsBackButtonVisible="Auto"
        IsBackEnabled="False"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="True"
        IsTitleBarAutoPaddingEnabled="False"
        ItemInvoked="NavView_ItemInvoked"
        BackRequested="NavView_BackRequested">

        <!-- Warna NavigationView diganti langsung di kontrolnya (lightweight styling) -->
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF242424" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF242424" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF1E1E1E" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FFFA2D48" />
        </NavigationView.Resources>

        <NavigationView.PaneHeader>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,16,0,8">
                <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="{StaticResource AccentRedBrush}" />
                <TextBlock Text="MusicPlayer" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.AutoSuggestBox>
            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="Search"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged"
                QuerySubmitted="SearchBox_QuerySubmitted" />
        </NavigationView.AutoSuggestBox>

        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="Library" />
            <NavigationViewItem Content="Recently Added" Tag="recent">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE823;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Artists" Tag="artists">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Albums" Tag="albums">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE93C;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Songs" Tag="songs">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Audio" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Genres" Tag="genres">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8EC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <!-- Grup "Folders" ditambahkan dari kode (RefreshFolderItems), karena isinya mengikuti Settings -->
        </NavigationView.MenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Bar atas yang menyatu dengan title bar. Area kosongnya dipakai untuk menggeser jendela;
                area yang bisa diklik (tombol dan LCD) dikecualikan lewat kode di MainWindow.xaml.cs.
                Kolom tengah (LCD) maksimal 600 px dan selalu di tengah; kalau jendela sempit, LCD ikut menyusut.
            -->
            <Grid
                x:Name="TopBar"
                Background="{StaticResource TopBarBackgroundBrush}"
                SizeChanged="TopBar_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="3*" MaxWidth="600" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition x:Name="CaptionButtonsColumn" Width="138" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="TransportPanel"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="16,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <!-- Shuffle dan repeat menyala merah saat aktif, sama seperti tombol antrean -->
                    <ToggleButton
                        x:Name="ShuffleToggle"
                        Padding="8"
                        MinWidth="40"
                        MinHeight="40"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{x:Bind Playback.IsShuffle, Mode=OneWay}"
                        Click="ShuffleToggle_Click"
                        ToolTipService.ToolTip="Shuffle">
                        <SymbolIcon Symbol="Shuffle" />
                    </ToggleButton>
                    <Button Style="{StaticResource TransportButtonStyle}" Click="Previous_Click" ToolTipService.ToolTip="Previous">
                        <SymbolIcon Symbol="Previous" />
                    </Button>
                    <Button Style="{StaticResource TransportButtonStyle}" Click="PlayPause_Click" ToolTipService.ToolTip="Play / Pause">
                        <SymbolIcon Symbol="{x:Bind Playback.PlayPauseSymbol, Mode=OneWay}" />
                    </Button>
                    <Button Style="{StaticResource TransportButtonStyle}" Click="Next_Click" ToolTipService.ToolTip="Next">
                        <SymbolIcon Symbol="Next" />
                    </Button>
                    <ToggleButton
                        x:Name="RepeatToggle"
                        Padding="8"
                        MinWidth="40"
                        MinHeight="40"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{x:Bind Playback.IsRepeatOn, Mode=OneWay}"
                        Click="RepeatToggle_Click"
                        ToolTipService.ToolTip="Repeat: off, all, or one">
                        <SymbolIcon Symbol="{x:Bind Playback.RepeatSymbol, Mode=OneWay}" />
                    </ToggleButton>
                </StackPanel>

                <!-- "LCD": cover, badge kualitas, judul dan artis (bergeser kalau kepanjangan), progres -->
                <Border
                    x:Name="LcdBorder"
                    Grid.Column="1"
                    Height="52"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    Background="{StaticResource LcdBackgroundBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Background="{StaticResource CoverPlaceholderBrush}" CornerRadius="6,0,0,6">
                            <FontIcon Glyph="&#xE8D6;" FontSize="20" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Border CornerRadius="6,0,0,6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind Playback.CurrentCover, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="1" Padding="8,4,8,3">
                            <!-- Kolom kiri (badge) dan kanan sama lebar, supaya judul tetap di tengah -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Badge kualitas; diklik untuk melihat detail format dan jalur output -->
                            <Button
                                Style="{StaticResource QualityBadgeButtonStyle}"
                                Content="{x:Bind Playback.QualityShortText, Mode=OneWay}"
                                Visibility="{x:Bind Playback.QualityVisibility, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <Button.Flyout>
                                    <Flyout x:Name="QualityFlyout" Placement="Bottom">
                                        <StackPanel Width="280" Spacing="4">
                                            <TextBlock
                                                Text="{x:Bind Playback.QualityBadgeText, Mode=OneWay}"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center" />
                                            <TextBlock
                                                Text="{x:Bind Playback.QualityDetailText, Mode=OneWay}"
                                                HorizontalAlignment="Center" />

                                            <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,8" />

                                            <TextBlock
                                                Text="{x:Bind Playback.OutputModeText, Mode=OneWay}"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource AccentRedBrush}"
                                                HorizontalAlignment="Center" />
                                            <TextBlock
                                                Text="{x:Bind Playback.OutputDetailText, Mode=OneWay}"
                                                TextWrapping="Wrap"
                                                TextAlignment="Center"
                                                HorizontalAlignment="Center" />
                                            <TextBlock
                                                Text="{x:Bind Playback.DeviceText, Mode=OneWay}"
                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                HorizontalAlignment="Center" />

                                            <Button
                                                Content="Audio settings"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,10,0,0"
                                                Click="AudioSettings_Click" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <controls:MarqueeText
                                Grid.Column="1"
                                Text="{x:Bind Playback.TitleText, Mode=OneWay}"
                                FontSize="12"
                                FontWeight="SemiBold" />

                            <controls:MarqueeText
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Text="{x:Bind Playback.SubtitleText, Mode=OneWay}"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryTextBrush}" />

                            <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnSpacing="8" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="{x:Bind Playback.ElapsedText, Mode=OneWay}"
                                    FontSize="10"
                                    Foreground="{StaticResource SecondaryTextBrush}" />

                                <!-- Area transparan yang lebih tinggi dari garis progres, supaya mudah diklik -->
                                <Grid
                                    Grid.Column="1"
                                    Height="12"
                                    Background="Transparent"
                                    PointerPressed="SeekBar_PointerPressed">
                                    <ProgressBar
                                        Minimum="0"
                                        Maximum="{x:Bind Playback.DurationSeconds, Mode=OneWay}"
                                        Value="{x:Bind Playback.PositionSeconds, Mode=OneWay}"
                                        Foreground="#CCFFFFFF"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind Playback.RemainingText, Mode=OneWay}"
                                    FontSize="10"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Kanan atas: pesan error (kalau ada) dan tombol panel antrean. Nanti disusul volume dan lirik -->
                <Grid Grid.Column="2" Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{x:Bind Playback.StatusText, Mode=OneWay}"
                        FontSize="11"
                        Foreground="{StaticResource AccentRedBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0" />
                    <StackPanel
                        x:Name="RightButtonsPanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <ToggleButton
                            x:Name="QueueToggle"
                            Padding="8"
                            MinWidth="40"
                            MinHeight="40"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Playing Next"
                            Click="QueueToggle_Click">
                            <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Frame x:Name="ContentFrame" />

                <!-- Panel Playing Next: lagu yang akan diputar berikutnya. Bisa digeser untuk mengubah urutan -->
                <Grid
                    x:Name="QueuePanel"
                    Grid.Column="1"
                    Width="340"
                    Visibility="Collapsed"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="1,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Padding="12,8,12,6" Spacing="4">
                        <SelectorBar x:Name="QueueTabs" SelectionChanged="QueueTabs_SelectionChanged">
                            <SelectorBarItem x:Name="UpNextTab" Text="Playing Next" IsSelected="True" />
                            <SelectorBarItem x:Name="HistoryTab" Text="History" />
                        </SelectorBar>
                        <Grid Padding="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="QueueCountText"
                                FontSize="12"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                VerticalAlignment="Center" />
                            <Button
                                x:Name="ClearQueueButton"
                                Grid.Column="1"
                                Content="Clear"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource AccentRedBrush}"
                                VerticalAlignment="Center"
                                Click="ClearQueue_Click" />
                        </Grid>
                    </StackPanel>

                    <ListView
                        x:Name="UpNextList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind Playback.UpNext}"
                        SelectionMode="Single"
                        CanDragItems="True"
                        CanReorderItems="True"
                        AllowDrop="True"
                        DoubleTapped="UpNextList_DoubleTapped"
                        RightTapped="UpNextList_RightTapped"
                        ContainerContentChanging="UpNextList_ContainerContentChanging">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueEntry">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="40" Height="40" CornerRadius="4" Background="{StaticResource CoverPlaceholderBrush}">
                                        <Border CornerRadius="4">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock
                                            Text="{x:Bind Subtitle}"
                                            FontSize="11"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind DurationText}"
                                        FontSize="12"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ListView
                        x:Name="HistoryList"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        SelectionMode="Single"
                        DoubleTapped="HistoryList_DoubleTapped"
                        RightTapped="HistoryList_RightTapped"
                        ContainerContentChanging="HistoryList_ContainerContentChanging">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryEntry">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="40" Height="40" CornerRadius="4" Background="{StaticResource CoverPlaceholderBrush}">
                                        <Border CornerRadius="4">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock
                                            Text="{x:Bind Subtitle}"
                                            FontSize="11"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind PlayedText}"
                                        FontSize="11"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="QueueEmptyText"
                        Grid.Row="1"
                        Margin="16,8,16,0"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>
            </Grid>
        </Grid>
    </NavigationView>
</Window>
