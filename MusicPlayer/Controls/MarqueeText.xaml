<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MusicPlayer.Controls.MarqueeText"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Canvas tidak membatasi lebar TextBlock, jadi teks yang panjang bisa digeser ke kiri -->
    <Canvas x:Name="Root" SizeChanged="Root_SizeChanged">
        <TextBlock
            x:Name="Label"
            TextWrapping="NoWrap"
            FontSize="{x:Bind FontSize, Mode=OneWay}"
            FontWeight="{x:Bind FontWeight, Mode=OneWay}"
            Foreground="{x:Bind Foreground, Mode=OneWay}">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="Offset" />
            </TextBlock.RenderTransform>
        </TextBlock>
    </Canvas>
</UserControl>
